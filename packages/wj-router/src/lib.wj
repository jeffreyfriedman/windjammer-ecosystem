use std::collections::HashMap
use std::strings

/// Match `path` against a pattern with optional `:param` segments.
/// Returns captured params on success, or `None` when the shape differs.
pub fn match_route(pattern: string, path: string) -> Option<HashMap<string, string>> {
    let pat_segs = split_segments(normalize_path(pattern))
    let path_segs = split_segments(normalize_path(path))
    if pat_segs.len() != path_segs.len() {
        return None
    }
    let mut params = HashMap::new()
    let mut i = 0
    while i < pat_segs.len() {
        let pat = pat_segs[i]
        let seg = path_segs[i]
        if strings.starts_with(pat, ":") {
            let name = strings.substring(pat, 1, strings.len(pat))
            if strings.len(name) == 0 {
                return None
            }
            params.insert(name, seg)
        } else {
            if pat != seg {
                return None
            }
        }
        i = i + 1
    }
    Some(params)
}

fn normalize_path(path: string) -> string {
    if strings.len(path) == 0 {
        return "/"
    }
    if path == "/" {
        return "/"
    }
    let mut out = path
    while strings.len(out) > 1 && strings.ends_with(out, "/") {
        out = strings.substring(out, 0, strings.len(out) - 1)
    }
    if !strings.starts_with(out, "/") {
        out = "/${out}"
    }
    out
}

fn split_segments(path: string) -> Vec<string> {
    let mut segs = Vec::new()
    if path == "/" {
        return segs
    }
    let body = strings.substring(path, 1, strings.len(path))
    if strings.len(body) == 0 {
        return segs
    }
    let parts = strings.split(body, "/")
    for part in parts {
        if strings.len(part) > 0 {
            segs.push(part)
        }
    }
    segs
}
