// The fixture is a 9.5 KB database written by Python's sqlite3 module (page size 512, so the items table has an interior
// page and one 1200-byte blob spills into overflow pages). "Z<n>" is a run of n zero bytes.
use crate::database::columns_of
use crate::database::open
use crate::database::rowid_alias
use crate::format::Value
use crate::format::decode_record
use crate::format::real_be
use crate::format::show
use crate::format::varint
use std::encoding

fn rle(parts: Vec<string>) -> Vec<u8> {
    let mut out: Vec<u8> = Vec::new()
    for p in parts {
        if p.starts_with("Z") {
            let n = p.substring(1, p.len()).parse::<int>().unwrap_or(0)
            let mut i = 0
            while i < n {
                out.push(0)
                i = i + 1
            }
        } else {
            for b in encoding.hex_decode(p).unwrap_or(Vec::new()) {
                out.push(b)
            }
        }
    }
    out
}

fn same(v: Value, spec: string) -> bool {
    let tag = spec.substring(0, 2)
    let body = spec.substring(2, spec.len())
    match v {
        Value::Null => tag == "n:",
        Value::Int(n) => tag == "i:" && n == body.parse::<int>().unwrap_or(0 - 1) && "${n}" == body,
        Value::Real(f) => tag == "r:" && f == body.parse::<float>().unwrap_or(0.0),
        Value::Text(t) => tag == "t:" && t == body,
        Value::Blob(b) => tag == "b:" && encoding.hex_encode(b) == body,
    }
}

fn row_matches(values: Vec<Value>, specs: Vec<string>) -> bool {
    if values.len() != specs.len() {
        return false
    }
    let mut i = 0
    while i < specs.len() {
        if !same(values[i], specs[i]) {
            return false
        }
        i = i + 1
    }
    true
}

