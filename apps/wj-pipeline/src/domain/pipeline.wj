/// One pipeline job (int payload for sync dogfood).
pub struct Job {
    pub id: int,
    pub payload: int,
}

/// Stage output.
pub struct JobResult {
    pub id: int,
    pub value: int,
}

/// Pure stage: double the payload.
pub fn transform(job: Job) -> JobResult {
    JobResult {
        id: job.id,
        value: job.payload * 2,
    }
}

/// Sum result values.
pub fn sum_results(results: Vec<JobResult>) -> int {
    let mut total = 0
    for r in results {
        total = total + r.value
    }
    total
}

pub fn result_count(results: Vec<JobResult>) -> int {
    let mut n = 0
    for _ in results {
        n = n + 1
    }
    n
}

pub fn is_empty_results(results: Vec<JobResult>) -> bool {
    result_count(results) == 0
}

pub fn max_result_value(results: Vec<JobResult>) -> int {
    let mut max = 0
    let mut seen = false
    for r in results {
        if !seen || r.value > max {
            max = r.value
            seen = true
        }
    }
    max
}

pub fn find_result_by_id(results: Vec<JobResult>, id: int) -> Option<JobResult> {
    for r in results {
        if r.id == id {
            return Some(r)
        }
    }
    None
}

pub fn min_result_value(results: Vec<JobResult>) -> int {
    let mut min = 0
    let mut seen = false
    for r in results {
        if !seen || r.value < min {
            min = r.value
            seen = true
        }
    }
    min
}

pub fn has_results(results: Vec<JobResult>) -> bool {
    !is_empty_results(results)
}
