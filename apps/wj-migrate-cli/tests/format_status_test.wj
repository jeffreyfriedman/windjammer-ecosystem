use crate::domain::format_status_result
use crate::domain::has_pending
use crate::domain::is_caught_up
use crate::domain::version_count

fn sample_pending() -> Vec<int> {
    let mut pending = Vec::new()
    pending.push(1)
    pending.push(2)
    pending
}

fn sample_applied() -> Vec<int> {
    let mut applied = Vec::new()
    applied.push(1)
    applied.push(2)
    applied
}

fn test_format_status_result_none_applied_all_pending() {
    let msg = format_status_result(Vec::new(), sample_pending())
    assert_str_contains(msg, "applied: (none)")
    assert_str_contains(msg, "pending:")
    assert_str_contains(msg, "1")
    assert_str_contains(msg, "2")
}

fn test_format_status_result_all_applied() {
    let msg = format_status_result(sample_applied(), Vec::new())
    assert_str_contains(msg, "pending: (none)")
    assert_str_contains(msg, "1")
}

fn test_status_version_helpers() {
    assert_eq(version_count(sample_pending()), 2)
    assert(has_pending(sample_pending()), "has pending")
    assert(!has_pending(Vec::new()), "no pending")
    assert(is_caught_up(Vec::new()), "caught up")
    assert(!is_caught_up(sample_pending()), "not caught up")
}
