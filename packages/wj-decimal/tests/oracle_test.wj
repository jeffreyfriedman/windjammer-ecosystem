@test
fn test_division_matches_python() {
    assert_eq(text_of(div(dec("1"), dec("3"), 0, mode_named("Down"))), "0")
    assert_eq(text_of(div(dec("1"), dec("3"), 0, mode_named("Up"))), "1")
    assert_eq(text_of(div(dec("1"), dec("3"), 0, mode_named("Floor"))), "0")
    assert_eq(text_of(div(dec("1"), dec("3"), 0, mode_named("Ceiling"))), "1")
    assert_eq(text_of(div(dec("1"), dec("3"), 0, mode_named("HalfUp"))), "0")
    assert_eq(text_of(div(dec("1"), dec("3"), 0, mode_named("HalfDown"))), "0")
    assert_eq(text_of(div(dec("1"), dec("3"), 0, mode_named("HalfEven"))), "0")
    assert_eq(text_of(div(dec("1"), dec("3"), 2, mode_named("Down"))), "0.33")
    assert_eq(text_of(div(dec("1"), dec("3"), 2, mode_named("Up"))), "0.34")
    assert_eq(text_of(div(dec("1"), dec("3"), 2, mode_named("Floor"))), "0.33")
    assert_eq(text_of(div(dec("1"), dec("3"), 2, mode_named("Ceiling"))), "0.34")
    assert_eq(text_of(div(dec("1"), dec("3"), 2, mode_named("HalfUp"))), "0.33")
    assert_eq(text_of(div(dec("1"), dec("3"), 2, mode_named("HalfDown"))), "0.33")
    assert_eq(text_of(div(dec("1"), dec("3"), 2, mode_named("HalfEven"))), "0.33")
    assert_eq(text_of(div(dec("1"), dec("3"), 4, mode_named("Down"))), "0.3333")
    assert_eq(text_of(div(dec("1"), dec("3"), 4, mode_named("Up"))), "0.3334")
    assert_eq(text_of(div(dec("1"), dec("3"), 4, mode_named("Floor"))), "0.3333")
    assert_eq(text_of(div(dec("1"), dec("3"), 4, mode_named("Ceiling"))), "0.3334")
    assert_eq(text_of(div(dec("1"), dec("3"), 4, mode_named("HalfUp"))), "0.3333")
    assert_eq(text_of(div(dec("1"), dec("3"), 4, mode_named("HalfDown"))), "0.3333")
    assert_eq(text_of(div(dec("1"), dec("3"), 4, mode_named("HalfEven"))), "0.3333")
    assert_eq(text_of(div(dec("2"), dec("3"), 0, mode_named("Down"))), "0")
    assert_eq(text_of(div(dec("2"), dec("3"), 0, mode_named("Up"))), "1")
    assert_eq(text_of(div(dec("2"), dec("3"), 0, mode_named("Floor"))), "0")
    assert_eq(text_of(div(dec("2"), dec("3"), 0, mode_named("Ceiling"))), "1")
    assert_eq(text_of(div(dec("2"), dec("3"), 0, mode_named("HalfUp"))), "1")
    assert_eq(text_of(div(dec("2"), dec("3"), 0, mode_named("HalfDown"))), "1")
    assert_eq(text_of(div(dec("2"), dec("3"), 0, mode_named("HalfEven"))), "1")
    assert_eq(text_of(div(dec("2"), dec("3"), 2, mode_named("Down"))), "0.66")
    assert_eq(text_of(div(dec("2"), dec("3"), 2, mode_named("Up"))), "0.67")
    assert_eq(text_of(div(dec("2"), dec("3"), 2, mode_named("Floor"))), "0.66")
    assert_eq(text_of(div(dec("2"), dec("3"), 2, mode_named("Ceiling"))), "0.67")
    assert_eq(text_of(div(dec("2"), dec("3"), 2, mode_named("HalfUp"))), "0.67")
    assert_eq(text_of(div(dec("2"), dec("3"), 2, mode_named("HalfDown"))), "0.67")
    assert_eq(text_of(div(dec("2"), dec("3"), 2, mode_named("HalfEven"))), "0.67")
    assert_eq(text_of(div(dec("2"), dec("3"), 4, mode_named("Down"))), "0.6666")
    assert_eq(text_of(div(dec("2"), dec("3"), 4, mode_named("Up"))), "0.6667")
    assert_eq(text_of(div(dec("2"), dec("3"), 4, mode_named("Floor"))), "0.6666")
    assert_eq(text_of(div(dec("2"), dec("3"), 4, mode_named("Ceiling"))), "0.6667")
    assert_eq(text_of(div(dec("2"), dec("3"), 4, mode_named("HalfUp"))), "0.6667")
    assert_eq(text_of(div(dec("2"), dec("3"), 4, mode_named("HalfDown"))), "0.6667")
    assert_eq(text_of(div(dec("2"), dec("3"), 4, mode_named("HalfEven"))), "0.6667")
    assert_eq(text_of(div(dec("-1"), dec("3"), 0, mode_named("Down"))), "0")
    assert_eq(text_of(div(dec("-1"), dec("3"), 0, mode_named("Up"))), "-1")
    assert_eq(text_of(div(dec("-1"), dec("3"), 0, mode_named("Floor"))), "-1")
    assert_eq(text_of(div(dec("-1"), dec("3"), 0, mode_named("Ceiling"))), "0")
    assert_eq(text_of(div(dec("-1"), dec("3"), 0, mode_named("HalfUp"))), "0")
