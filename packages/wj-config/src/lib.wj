use std::collections::HashMap
use std::config

/// Later map wins on shared keys. Keys only in `base` are kept.
///
/// Kept as pure WJ until tip `config.resolve` owned-HashMap call sites are GREEN
/// (`bug_std_config_module_test::std_config_resolve_must_wire`).
pub fn merge(base: HashMap<string, string>, overlay: HashMap<string, string>) -> HashMap<string, string> {
    let mut out = base
    for (key, value) in overlay {
        out.insert(key, value)
    }
    out
}

/// Overlay `env_map` onto `map` only for keys that already exist (process env must not invent keys).
pub fn overlay_matching(map: HashMap<string, string>, env_map: HashMap<string, string>) -> HashMap<string, string> {
    let mut out = map
    for (key, value) in env_map {
        if out.contains_key(key) {
            out.insert(key, value)
        }
    }
    out
}

/// defaults < file < matching env keys.
pub fn resolve(defaults: HashMap<string, string>, file: HashMap<string, string>, env_map: HashMap<string, string>) -> HashMap<string, string> {
    overlay_matching(merge(defaults, file), env_map)
}

/// Parse TOML config text into a flat dotted-key string map (`std::config.parse_flat`).
pub fn from_toml(text: string) -> HashMap<string, string> {
    match config.parse_flat(text, "toml") {
        Ok(map) => map,
        Err(_) => HashMap::new(),
    }
}

/// Parse YAML config text into a flat dotted-key string map (`std::config.parse_flat`).
pub fn from_yaml(text: string) -> HashMap<string, string> {
    match config.parse_flat(text, "yaml") {
        Ok(map) => map,
        Err(_) => HashMap::new(),
    }
}

/// defaults < TOML file text < matching env keys.
pub fn resolve_toml(
    defaults: HashMap<string, string>,
    toml_text: string,
    env_map: HashMap<string, string>,
) -> HashMap<string, string> {
    resolve(defaults, from_toml(toml_text), env_map)
}

/// defaults < YAML file text < matching env keys.
pub fn resolve_yaml(
    defaults: HashMap<string, string>,
    yaml_text: string,
    env_map: HashMap<string, string>,
) -> HashMap<string, string> {
    resolve(defaults, from_yaml(yaml_text), env_map)
}
