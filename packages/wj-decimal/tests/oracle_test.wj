    assert_eq(text_of(rescale(dec("-0.125"), 0, mode_named("HalfEven"))), "0")
    assert_eq(text_of(rescale(dec("-0.125"), 1, mode_named("Down"))), "-0.1")
    assert_eq(text_of(rescale(dec("-0.125"), 1, mode_named("Up"))), "-0.2")
    assert_eq(text_of(rescale(dec("-0.125"), 1, mode_named("Floor"))), "-0.2")
    assert_eq(text_of(rescale(dec("-0.125"), 1, mode_named("Ceiling"))), "-0.1")
    assert_eq(text_of(rescale(dec("-0.125"), 1, mode_named("HalfUp"))), "-0.1")
    assert_eq(text_of(rescale(dec("-0.125"), 1, mode_named("HalfDown"))), "-0.1")
    assert_eq(text_of(rescale(dec("-0.125"), 1, mode_named("HalfEven"))), "-0.1")
