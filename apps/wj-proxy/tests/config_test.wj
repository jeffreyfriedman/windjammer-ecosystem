use crate::domain::ProxyConfig
use crate::domain::has_strip_prefix
use crate::domain::is_unlimited_log
use crate::domain::require_limited_log
use crate::domain::require_strip
use std::strings

fn test_config_defaults() {
    let cfg = ProxyConfig::defaults()
    assert_eq(cfg.upstream, "http://127.0.0.1:9000")
    assert_eq(cfg.strip_prefix, "")
    assert_eq(cfg.rate_limit, 100)
    assert_eq(cfg.window_ms, 60_000)
    assert_eq(cfg.log_max, 1000)
}

fn test_strip_and_log_predicates() {
    assert(!has_strip_prefix(ProxyConfig::defaults()), "no strip")
    assert(!is_unlimited_log(ProxyConfig::defaults()), "capped")
    let mut cfg = ProxyConfig::defaults()
    cfg.strip_prefix = "/api"
    cfg.log_max = 0
    assert(has_strip_prefix(cfg), "has strip")
    let mut unlimited = ProxyConfig::defaults()
    unlimited.log_max = 0
    assert(is_unlimited_log(unlimited), "unlimited")
}

fn test_require_strip() {
    match require_strip(ProxyConfig::defaults()) {
        Ok(_) => assert(false, "empty prefix must Err"),
        Err(msg) => assert(strings.contains(msg, "strip"), "mentions strip"),
    }
    let mut cfg = ProxyConfig::defaults()
    cfg.strip_prefix = "/api"
    match require_strip(cfg) {
        Ok(prefix) => assert_eq(prefix, "/api"),
        Err(_) => assert(false, "has strip"),
    }
}

fn test_upstream_rate_and_log_accessors() {
    use crate::domain::is_limited_log
    use crate::domain::log_max_of
    use crate::domain::rate_limit_of
    use crate::domain::upstream_of
    assert_eq(upstream_of(ProxyConfig::defaults()), "http://127.0.0.1:9000")
    assert_eq(rate_limit_of(ProxyConfig::defaults()), 100)
    assert_eq(log_max_of(ProxyConfig::defaults()), 1000)
    assert(is_limited_log(ProxyConfig::defaults()), "defaults capped")
    let mut unlimited = ProxyConfig::defaults()
    unlimited.log_max = 0
    assert(!is_limited_log(unlimited), "unlimited not limited")
}

fn test_require_upstream_and_rate_limit() {
    use crate::domain::require_rate_limit
    use crate::domain::require_upstream
    match require_upstream(ProxyConfig::defaults()) {
        Ok(url) => assert_eq(url, "http://127.0.0.1:9000"),
        Err(_) => assert(false, "default upstream"),
    }
    let mut blank = ProxyConfig::defaults()
    blank.upstream = ""
    match require_upstream(blank) {
        Ok(_) => assert(false, "blank upstream must Err"),
        Err(msg) => assert(strings.contains(msg, "upstream"), "mentions upstream"),
    }
    match require_rate_limit(ProxyConfig::defaults()) {
        Ok(n) => assert_eq(n, 100),
        Err(_) => assert(false, "default rate"),
    }
    let mut zero = ProxyConfig::defaults()
    zero.rate_limit = 0
    match require_rate_limit(zero) {
        Ok(_) => assert(false, "zero rate must Err"),
        Err(msg) => assert(strings.contains(msg, "rate"), "mentions rate"),
    }
}

fn test_require_limited_log() {
    match require_limited_log(ProxyConfig::defaults()) {
        Ok(n) => assert_eq(n, 1000),
        Err(_) => assert(false, "default log cap"),
    }
    let mut unlimited = ProxyConfig::defaults()
    unlimited.log_max = 0
    match require_limited_log(unlimited) {
        Ok(_) => assert(false, "unlimited must Err"),
        Err(msg) => assert(strings.contains(msg, "limited"), "mentions limited"),
    }
}
