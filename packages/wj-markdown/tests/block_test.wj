// Expected HTML comes from markdown-it-py 3.0.0 (CommonMark preset, html disabled): the independent oracle.
// Inputs include examples from the CommonMark 0.30 spec.
use crate::to_html

fn check_doc(source: string, expected: string) -> string {
    let got = to_html(source)
    if got != expected {
        return "MISMATCH for ${source:?}\n  want ${expected:?}\n  got  ${got:?}\n"
    }
    ""
}

@test
fn test_blocks_match_commonmark_oracle() {
    let mut failures = ""
    failures = failures + check_doc("# foo", "<h1>foo</h1>\n")
    failures = failures + check_doc("## foo", "<h2>foo</h2>\n")
    failures = failures + check_doc("###### foo", "<h6>foo</h6>\n")
    failures = failures + check_doc("####### foo", "<p>####### foo</p>\n")
    failures = failures + check_doc("#5 bolt", "<p>#5 bolt</p>\n")
    failures = failures + check_doc("#hashtag", "<p>#hashtag</p>\n")
    failures = failures + check_doc("# foo *bar* \\*baz\\*", "<h1>foo <em>bar</em> *baz*</h1>\n")
    failures = failures + check_doc("#                  foo                     ", "<h1>foo</h1>\n")
    failures = failures + check_doc("### foo ###", "<h3>foo</h3>\n")
    failures = failures + check_doc("# foo #\\##", "<h1>foo ###</h1>\n")
    failures = failures + check_doc("#", "<h1></h1>\n")
    failures = failures + check_doc("### ###", "<h3></h3>\n")
    failures = failures + check_doc("***", "<hr />\n")
    failures = failures + check_doc("---", "<hr />\n")
    failures = failures + check_doc("___", "<hr />\n")
    failures = failures + check_doc(" - - -", "<hr />\n")
    failures = failures + check_doc("- foo\n***\n- bar", "<ul>\n<li>foo</li>\n</ul>\n<hr />\n<ul>\n<li>bar</li>\n</ul>\n")
    failures = failures + check_doc("Foo\n---", "<h2>Foo</h2>\n")
    failures = failures + check_doc("Foo *bar*\n=========", "<h1>Foo <em>bar</em></h1>\n")
    failures = failures + check_doc("Foo\nbar\n---\nbaz", "<h2>Foo\nbar</h2>\n<p>baz</p>\n")
    failures = failures + check_doc("aaa\n\nbbb", "<p>aaa</p>\n<p>bbb</p>\n")
    failures = failures + check_doc("aaa\nbbb\n\nccc\nddd", "<p>aaa\nbbb</p>\n<p>ccc\nddd</p>\n")
    failures = failures + check_doc("  aaa\n bbb", "<p>aaa\nbbb</p>\n")
    failures = failures + check_doc("aaa\n             bbb\n                                       ccc", "<p>aaa\nbbb\nccc</p>\n")
    failures = failures + check_doc("```\n<\n >\n```", "<pre><code>&lt;\n &gt;\n</code></pre>\n")
    failures = failures + check_doc("~~~\n<\n >\n~~~", "<pre><code>&lt;\n &gt;\n</code></pre>\n")
    failures = failures + check_doc("```ruby\ndef foo(x)\n  return 3\nend\n```", "<pre><code class=\"language-ruby\">def foo(x)\n  return 3\nend\n</code></pre>\n")
    failures = failures + check_doc("```\naaa\n~~~\n```", "<pre><code>aaa\n~~~\n</code></pre>\n")
    failures = failures + check_doc("````\naaa\n```\n``````", "<pre><code>aaa\n```\n</code></pre>\n")
    failures = failures + check_doc("```", "<pre><code></code></pre>\n")
    failures = failures + check_doc("```\n\n  \n```", "<pre><code>\n  \n</code></pre>\n")
    failures = failures + check_doc("```\n```", "<pre><code></code></pre>\n")
    failures = failures + check_doc(" ```\n aaa\naaa\n```", "<pre><code>aaa\naaa\n</code></pre>\n")
    failures = failures + check_doc("    a simple\n      indented code block", "<pre><code>a simple\n  indented code block\n</code></pre>\n")
    failures = failures + check_doc("    chunk1\n\n    chunk2", "<pre><code>chunk1\n\nchunk2\n</code></pre>\n")
    failures = failures + check_doc("Foo\n    bar", "<p>Foo\nbar</p>\n")
    failures = failures + check_doc("> # Foo\n> bar\n> baz", "<blockquote>\n<h1>Foo</h1>\n<p>bar\nbaz</p>\n</blockquote>\n")
    failures = failures + check_doc("># Foo\n>bar\n> baz", "<blockquote>\n<h1>Foo</h1>\n<p>bar\nbaz</p>\n</blockquote>\n")
    failures = failures + check_doc("> bar\nbaz", "<blockquote>\n<p>bar\nbaz</p>\n</blockquote>\n")
    failures = failures + check_doc("> foo\n---", "<blockquote>\n<p>foo</p>\n</blockquote>\n<hr />\n")
    failures = failures + check_doc("> foo\n\n> bar", "<blockquote>\n<p>foo</p>\n</blockquote>\n<blockquote>\n<p>bar</p>\n</blockquote>\n")
    failures = failures + check_doc("- foo\n- bar\n- baz", "<ul>\n<li>foo</li>\n<li>bar</li>\n<li>baz</li>\n</ul>\n")
    failures = failures + check_doc("+ a\n+ b", "<ul>\n<li>a</li>\n<li>b</li>\n</ul>\n")
    failures = failures + check_doc("1. foo\n2. bar", "<ol>\n<li>foo</li>\n<li>bar</li>\n</ol>\n")
    failures = failures + check_doc("3. a\n4. b", "<ol start=\"3\">\n<li>a</li>\n<li>b</li>\n</ol>\n")
    failures = failures + check_doc("1) a\n2) b", "<ol>\n<li>a</li>\n<li>b</li>\n</ol>\n")
    failures = failures + check_doc("- foo\n\n- bar\n\n\n- baz", "<ul>\n<li>\n<p>foo</p>\n</li>\n<li>\n<p>bar</p>\n</li>\n<li>\n<p>baz</p>\n</li>\n</ul>\n")
    failures = failures + check_doc("- a\n  - b\n  - c\n- d", "<ul>\n<li>a\n<ul>\n<li>b</li>\n<li>c</li>\n</ul>\n</li>\n<li>d</li>\n</ul>\n")
    failures = failures + check_doc("1. a\n\n   b\n2. c", "<ol>\n<li>\n<p>a</p>\n<p>b</p>\n</li>\n<li>\n<p>c</p>\n</li>\n</ol>\n")
    failures = failures + check_doc("- a\n- b\n\n  c", "<ul>\n<li>\n<p>a</p>\n</li>\n<li>\n<p>b</p>\n<p>c</p>\n</li>\n</ul>\n")
    failures = failures + check_doc("* foo\n  bar\n* baz", "<ul>\n<li>foo\nbar</li>\n<li>baz</li>\n</ul>\n")
    failures = failures + check_doc("10. foo\n    bar", "<ol start=\"10\">\n<li>foo\nbar</li>\n</ol>\n")
    failures = failures + check_doc("The number of windows in my house is\n14.", "<p>The number of windows in my house is\n14.</p>\n")
    failures = failures + check_doc("- foo\n- bar\n+ baz", "<ul>\n<li>foo</li>\n<li>bar</li>\n</ul>\n<ul>\n<li>baz</li>\n</ul>\n")
    failures = failures + check_doc("1. foo\n2. bar\n3) baz", "<ol>\n<li>foo</li>\n<li>bar</li>\n</ol>\n<ol start=\"3\">\n<li>baz</li>\n</ol>\n")
    failures = failures + check_doc("Foo\n- bar\n- baz", "<p>Foo</p>\n<ul>\n<li>bar</li>\n<li>baz</li>\n</ul>\n")
    failures = failures + check_doc("- ```\n  code\n  ```\n- x", "<ul>\n<li>\n<pre><code>code\n</code></pre>\n</li>\n<li>x</li>\n</ul>\n")
    failures = failures + check_doc("- one\n\n  two", "<ul>\n<li>\n<p>one</p>\n<p>two</p>\n</li>\n</ul>\n")
    failures = failures + check_doc("-\n  foo", "<ul>\n<li>foo</li>\n</ul>\n")
    failures = failures + check_doc("- foo\n-\n- bar", "<ul>\n<li>foo</li>\n<li></li>\n<li>bar</li>\n</ul>\n")
    failures = failures + check_doc("> - a\n> - b", "<blockquote>\n<ul>\n<li>a</li>\n<li>b</li>\n</ul>\n</blockquote>\n")
    failures = failures + check_doc("- > quote\n  > more", "<ul>\n<li>\n<blockquote>\n<p>quote\nmore</p>\n</blockquote>\n</li>\n</ul>\n")
    failures = failures + check_doc("text with `code` and **strong** in a para\nsecond line", "<p>text with <code>code</code> and <strong>strong</strong> in a para\nsecond line</p>\n")
    failures = failures + check_doc("<div>\nhello\n</div>", "<p>&lt;div&gt;\nhello\n&lt;/div&gt;</p>\n")
    failures = failures + check_doc("<script>alert(1)</script>", "<p>&lt;script&gt;alert(1)&lt;/script&gt;</p>\n")
    failures = failures + check_doc("[x](javascript:alert(1))\n\n[ok](/ok)", "<p>[x](javascript:alert(1))</p>\n<p><a href=\"/ok\">ok</a></p>\n")
    failures = failures + check_doc("Setext *em*\n===\n\npara", "<h1>Setext <em>em</em></h1>\n<p>para</p>\n")
    failures = failures + check_doc("a\\\nb", "<p>a<br />\nb</p>\n")
    failures = failures + check_doc("line one  \nline two", "<p>line one<br />\nline two</p>\n")
    assert(failures == "", failures)
}
