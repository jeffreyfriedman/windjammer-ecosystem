use crate::all_ok
use crate::require_email
use crate::require_int_range
use crate::require_max_len
use crate::require_min_len
use crate::require_nonempty
use crate::require_one_of
use std::strings

@test
fn test_require_nonempty_ok() {
    match require_nonempty("name", "Ada") {
        Ok(v) => assert_eq(v, "Ada"),
        Err(_) => assert(false, "expected Ok"),
    }
}

@test
fn test_require_nonempty_trims() {
    match require_nonempty("name", "  Ada  ") {
        Ok(v) => assert_eq(v, "Ada"),
        Err(_) => assert(false, "expected Ok"),
    }
}

@test
fn test_require_nonempty_blank_err() {
    match require_nonempty("name", "   ") {
        Ok(_) => assert(false, "expected Err"),
        Err(msg) => assert(strings.contains(msg, "name"), "field in error"),
    }
}

@test
fn test_require_min_len_ok() {
    match require_min_len("password", "secret", 6) {
        Ok(v) => assert_eq(v, "secret"),
        Err(_) => assert(false, "expected Ok"),
    }
}

@test
fn test_require_min_len_err() {
    match require_min_len("password", "hi", 6) {
        Ok(_) => assert(false, "expected Err"),
        Err(_) => assert(true, "too short"),
    }
}

@test
fn test_require_max_len_ok() {
    match require_max_len("code", "ab", 3) {
        Ok(v) => assert_eq(v, "ab"),
        Err(_) => assert(false, "expected Ok"),
    }
}

@test
fn test_require_max_len_err() {
    match require_max_len("code", "abcd", 3) {
        Ok(_) => assert(false, "expected Err"),
        Err(_) => assert(true, "too long"),
    }
}

@test
fn test_require_email_ok() {
    match require_email("email", "ada@example.com") {
        Ok(v) => assert_eq(v, "ada@example.com"),
        Err(_) => assert(false, "expected Ok"),
    }
}

@test
fn test_require_email_err() {
    match require_email("email", "not-an-email") {
        Ok(_) => assert(false, "expected Err"),
        Err(_) => assert(true, "bad email"),
    }
}

@test
fn test_require_int_range_ok() {
    match require_int_range("age", 30, 0, 120) {
        Ok(v) => assert_eq(v, 30),
        Err(_) => assert(false, "expected Ok"),
    }
}

@test
fn test_require_int_range_low_err() {
    match require_int_range("age", -1, 0, 120) {
        Ok(_) => assert(false, "expected Err"),
        Err(_) => assert(true, "too low"),
    }
}

@test
fn test_require_int_range_high_err() {
    match require_int_range("age", 200, 0, 120) {
        Ok(_) => assert(false, "expected Err"),
        Err(_) => assert(true, "too high"),
    }
}

@test
fn test_require_one_of_ok() {
    let mut allowed = Vec::new()
    allowed.push("red")
    allowed.push("blue")
    match require_one_of("color", "blue", allowed) {
        Ok(v) => assert_eq(v, "blue"),
        Err(_) => assert(false, "expected Ok"),
    }
}

@test
fn test_require_one_of_err() {
    let mut allowed = Vec::new()
    allowed.push("red")
    allowed.push("blue")
    match require_one_of("color", "green", allowed) {
        Ok(_) => assert(false, "expected Err"),
        Err(_) => assert(true, "not allowed"),
    }
}

@test
fn test_all_ok_empty() {
    let errors = Vec::new()
    match all_ok(errors) {
        Ok(_) => assert(true, "ok"),
        Err(_) => assert(false, "expected Ok"),
    }
}

@test
fn test_all_ok_with_errors() {
    let mut errors = Vec::new()
    errors.push("name is required")
    errors.push("age out of range")
    match all_ok(errors) {
        Ok(_) => assert(false, "expected Err"),
        Err(msg) => {
            assert(strings.contains(msg, "name is required"), "first err")
            assert(strings.contains(msg, "age out of range"), "second err")
        },
    }
}
