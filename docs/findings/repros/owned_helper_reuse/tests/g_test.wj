use crate::collect
use crate::continues
use crate::gaps

fn test_gaps() {
    let mut v: Vec<string> = Vec::new()
    v.push("")
    v.push("x")
    assert_eq(gaps(v), 11)
    assert(continues("a", "b"), "plain continuation")
}

fn test_collect() {
    let mut v: Vec<string> = Vec::new()
    v.push("a")
    v.push("- b")
    v.push("c")
    assert_eq(collect(v).len(), 2)
}
