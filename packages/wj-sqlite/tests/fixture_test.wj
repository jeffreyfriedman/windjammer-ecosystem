@test
fn test_header_and_pages() {
    let db = match open(fixture()) {
        Ok(d) => d,
        Err(e) => return assert(false, e),
    }
    assert_eq(db.page_size(), 512)
    assert_eq(db.page_count(), 19)
}

fn describe_table(name: string) -> string {
    let db = match open(fixture()) {
        Ok(d) => d,
        Err(e) => return "open: ${e}",
    }
    match db.table(name) {
        Ok(t) => "${t.columns.join(",")}|${t.rowid_column}",
        Err(e) => e,
    }
}

@test
fn test_tables_and_columns_come_from_sqlite_master() {
    let db = match open(fixture()) {
        Ok(d) => d,
        Err(e) => return assert(false, e),
    }
    let mut names: Vec<string> = Vec::new()
    for t in db.tables().unwrap_or(Vec::new()) {
        names.push(t.name)
    }
    names.sort()
    assert_eq(names.join(","), "items,kv,odd table")
    assert_eq(describe_table("items"), "id,name,price,qty,note,tag|0")
    assert_eq(describe_table("odd table"), "my col,other,third|-1")
    assert_eq(describe_table("kv"), "k,v|-1")
    assert_eq(describe_table("nope"), "no table named 'nope'")
}

@test
fn test_every_row_of_every_table_matches_python() {
    assert_eq(mismatches("items", expected_items()), "")
    assert_eq(mismatches("odd table", expected_odd_table()), "")
    assert_eq(mismatches("kv", expected_kv()), "")
}
