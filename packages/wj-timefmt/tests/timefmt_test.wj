use crate::require_same_month
use crate::require_same_year
use crate::require_before
use crate::require_after
use std::strings

@test
fn test_parse_rfc3339_zulu() {
    match parse_rfc3339("2024-01-15T12:30:00Z") {
        Ok(t) => {
            assert_eq(t.year, 2024)
            assert_eq(t.month, 1)
            assert_eq(t.day, 15)
            assert_eq(t.hour, 12)
            assert_eq(t.minute, 30)
            assert_eq(t.second, 0)
            assert_eq(t.offset_minutes, 0)
        },
        Err(_) => assert(false, "parse zulu"),
    }
}

@test
fn test_format_rfc3339_zulu() {
    match parse_rfc3339("2024-01-15T12:30:00Z") {
        Ok(t) => assert_eq(format_rfc3339(t), "2024-01-15T12:30:00Z"),
        Err(_) => assert(false, "parse for format"),
    }
}

@test
fn test_roundtrip() {
    match parse_rfc3339("2020-06-01T08:05:09Z") {
        Ok(t) => assert_eq(format_rfc3339(t), "2020-06-01T08:05:09Z"),
        Err(_) => assert(false, "roundtrip parse"),
    }
}

@test
fn test_parse_positive_offset() {
    match parse_rfc3339("2024-03-10T18:45:00+05:30") {
        Ok(t) => {
            assert_eq(t.year, 2024)
            assert_eq(t.month, 3)
            assert_eq(t.day, 10)
            assert_eq(t.hour, 18)
            assert_eq(t.minute, 45)
            assert_eq(t.second, 0)
            assert_eq(t.offset_minutes, 330)
        },
        Err(_) => assert(false, "parse positive offset"),
    }
}

@test
fn test_parse_negative_offset() {
    match parse_rfc3339("2024-07-04T09:00:00-08:00") {
        Ok(t) => {
            assert_eq(t.hour, 9)
            assert_eq(t.offset_minutes, -480)
        },
        Err(_) => assert(false, "parse negative offset"),
    }
}

@test
fn test_format_positive_offset() {
    match parse_rfc3339("2024-03-10T18:45:00+05:30") {
        Ok(t) => assert_eq(format_rfc3339(t), "2024-03-10T18:45:00+05:30"),
        Err(_) => assert(false, "format offset"),
    }
}

@test
fn test_format_negative_offset() {
    match parse_rfc3339("2024-07-04T09:00:00-08:00") {
        Ok(t) => assert_eq(format_rfc3339(t), "2024-07-04T09:00:00-08:00"),
        Err(_) => assert(false, "format neg offset"),
    }
}

@test
fn test_parse_zero_offset() {
    match parse_rfc3339("2024-01-01T00:00:00+00:00") {
        Ok(t) => {
            assert_eq(t.offset_minutes, 0)
            assert_eq(format_rfc3339(t), "2024-01-01T00:00:00Z")
        },
        Err(_) => assert(false, "parse zero offset"),
    }
}

@test
fn test_parse_rejects_empty() {
    match parse_rfc3339("") {
        Ok(_) => assert(false, "expected Err"),
        Err(_) => {},
    }
}

@test
fn test_parse_rejects_bad_shape() {
    match parse_rfc3339("not-a-date") {
        Ok(_) => assert(false, "expected Err"),
        Err(_) => {},
    }
}

@test
fn test_epoch_zulu() {
    match parse_rfc3339("1970-01-01T00:00:00Z") {
        Ok(t) => assert_eq(to_epoch_secs(t), 0),
        Err(_) => assert(false, "epoch parse"),
    }
}

@test
fn test_epoch_known_date() {
    match parse_rfc3339("2024-01-01T00:00:00Z") {
        Ok(t) => {
            let e = to_epoch_secs(t)
            assert(e > 1704000000, "epoch 2024")
            assert(e < 1704100000, "epoch 2024 upper")
        },
        Err(_) => assert(false, "epoch 2024 parse"),
    }
}

@test
fn test_from_epoch_secs_zero() {
    let t = from_epoch_secs(0)
    assert_eq(t.year, 1970)
    assert_eq(t.month, 1)
    assert_eq(t.day, 1)
    assert_eq(t.hour, 0)
}

@test
fn test_epoch_roundtrip() {
    match parse_rfc3339("2024-06-15T10:30:45Z") {
        Ok(t) => {
            let e = to_epoch_secs(t)
            let back = from_epoch_secs(e)
            assert_eq(back.year, 2024)
            assert_eq(back.month, 6)
            assert_eq(back.day, 15)
            assert_eq(back.hour, 10)
            assert_eq(back.minute, 30)
            assert_eq(back.second, 45)
        },
        Err(_) => assert(false, "epoch roundtrip parse"),
    }
}

@test
fn test_compare_equal() {
    match parse_rfc3339("2024-01-01T00:00:00Z") {
        Ok(a) => {
            match parse_rfc3339("2024-01-01T00:00:00Z") {
                Ok(b) => assert_eq(compare(a, b), 0),
                Err(_) => assert(false, "b"),
            }
        },
        Err(_) => assert(false, "a"),
    }
}

@test
fn test_compare_before_after() {
    match parse_rfc3339("2024-01-01T00:00:00Z") {
        Ok(a) => {
            match parse_rfc3339("2024-06-01T00:00:00Z") {
                Ok(b) => {
                    assert(is_before(a, b), "a before b")
                    assert(is_after(b, a), "b after a")
                    assert_eq(compare(a, b), -1)
                    assert_eq(compare(b, a), 1)
                },
                Err(_) => assert(false, "b"),
            }
        },
        Err(_) => assert(false, "a"),
    }
}

@test
fn test_is_leap_year() {
    assert(is_leap_year(2000), "2000 leap")
    assert(is_leap_year(2024), "2024 leap")
    assert(!is_leap_year(1900), "1900 not leap")
    assert(!is_leap_year(2023), "2023 not leap")
}

@test
fn test_days_in_month() {
    assert_eq(days_in_month(2024, 1), 31)
    assert_eq(days_in_month(2024, 2), 29)
    assert_eq(days_in_month(2023, 2), 28)
    assert_eq(days_in_month(2024, 4), 30)
    assert_eq(days_in_month(2024, 12), 31)
}

@test
fn test_now_rfc3339_shape() {
    let s = now_rfc3339()
    assert(strings.len(s) >= 20, "rfc3339 min length")
    assert(strings.contains(s, "T"), "has T separator")
}

@test
fn test_now_epoch_secs_positive() {
    assert(now_epoch_secs() > 1_700_000_000, "after 2023")
}

@test
fn test_is_equal() {
    match parse_rfc3339("2024-01-15T12:00:00Z") {
        Ok(a) => {
            match parse_rfc3339("2024-01-15T12:00:00Z") {
                Ok(b) => {
                    assert(is_equal(a, b), "same instant")
                    assert_eq(compare(a, b), 0)
                },
                Err(_) => assert(false, "b"),
            }
        },
        Err(_) => assert(false, "a"),
    }
}

@test
fn test_add_secs() {
    match parse_rfc3339("2024-01-15T12:00:00Z") {
        Ok(t) => {
            let later = add_secs(t, 90)
            assert_eq(later.hour, 12)
            assert_eq(later.minute, 1)
            assert_eq(later.second, 30)
        },
        Err(_) => assert(false, "parse later"),
    }
    match parse_rfc3339("2024-01-15T12:00:00Z") {
        Ok(t) => {
            let earlier = add_secs(t, -30)
            assert_eq(earlier.minute, 59)
            assert_eq(earlier.second, 30)
            assert_eq(earlier.hour, 11)
        },
        Err(_) => assert(false, "parse earlier"),
    }
}

@test
fn test_diff_secs_and_sub_secs() {
    match parse_rfc3339("2024-01-15T12:00:00Z") {
        Ok(a) => {
            match parse_rfc3339("2024-01-15T12:01:30Z") {
                Ok(b) => {
                    assert_eq(diff_secs(b, a), 90)
                    assert_eq(diff_secs(a, b), -90)
                    let earlier = sub_secs(b, 90)
                    assert(is_equal(earlier, a), "sub_secs round-trip")
                },
                Err(_) => assert(false, "parse b"),
            }
        },
        Err(_) => assert(false, "parse a"),
    }
}

@test
fn test_is_same_day() {
    match parse_rfc3339("2024-01-15T01:00:00Z") {
        Ok(a) => {
            match parse_rfc3339("2024-01-15T23:00:00Z") {
                Ok(b) => assert(is_same_day(a, b), "same calendar day"),
                Err(_) => assert(false, "parse b"),
            }
            match parse_rfc3339("2024-01-16T00:00:00Z") {
                Ok(c) => assert(!is_same_day(a, c), "next day"),
                Err(_) => assert(false, "parse c"),
            }
        },
        Err(_) => assert(false, "parse a"),
    }
}

@test
fn test_is_same_month_and_year() {
    match parse_rfc3339("2024-01-15T12:00:00Z") {
        Ok(a) => {
            match parse_rfc3339("2024-01-31T00:00:00Z") {
                Ok(b) => {
                    assert(is_same_month(a, b), "same month")
                    assert(is_same_year(a, b), "same year")
                },
                Err(_) => assert(false, "parse b"),
            }
            match parse_rfc3339("2024-02-01T00:00:00Z") {
                Ok(c) => {
                    assert(!is_same_month(a, c), "next month")
                    assert(is_same_year(a, c), "same year across months")
                },
                Err(_) => assert(false, "parse c"),
            }
            match parse_rfc3339("2025-01-15T00:00:00Z") {
                Ok(d) => {
                    assert(!is_same_month(a, d), "different year")
                    assert(!is_same_year(a, d), "next year")
                },
                Err(_) => assert(false, "parse d"),
            }
        },
        Err(_) => assert(false, "parse a"),
    }
}

fn sample_zulu() -> Rfc3339 {
    match parse_rfc3339("2024-01-15T12:30:00Z") {
        Ok(t) => t,
        Err(_) => Rfc3339 {
            year: 0,
            month: 0,
            day: 0,
            hour: 0,
            minute: 0,
            second: 0,
            offset_minutes: 0,
        },
    }
}

@test
fn test_component_accessors_and_zulu() {
    assert_eq(year_of(sample_zulu()), 2024)
    assert_eq(month_of(sample_zulu()), 1)
    assert_eq(day_of(sample_zulu()), 15)
    assert_eq(hour_of(sample_zulu()), 12)
    assert(is_zulu(sample_zulu()), "zulu")
    match parse_rfc3339("2024-01-15T12:30:00+01:00") {
        Ok(t) => assert(!is_zulu(t), "offset"),
        Err(_) => assert(false, "parse offset"),
    }
}

@test
fn test_minute_second_and_midnight() {
    use crate::is_midnight
    use crate::minute_of
    use crate::second_of
    match parse_rfc3339("2024-01-15T00:00:00Z") {
        Ok(t) => {
            assert_eq(minute_of(t), 0)
            assert_eq(second_of(t), 0)
            assert(is_midnight(t), "midnight")
        },
        Err(_) => assert(false, "midnight parse"),
    }
    match parse_rfc3339("2024-01-15T12:34:56Z") {
        Ok(t) => {
            assert_eq(minute_of(t), 34)
            assert_eq(second_of(t), 56)
            assert(!is_midnight(t), "noon not midnight")
        },
        Err(_) => assert(false, "clock parse"),
    }
}

@test
fn test_require_zulu() {
    use crate::require_zulu
    match require_zulu(sample_zulu()) {
        Ok(text) => assert(strings.contains(text, "2024"), "keeps year"),
        Err(_) => assert(false, "zulu"),
    }
    match parse_rfc3339("2024-01-15T12:30:00+01:00") {
        Ok(t) => {
            match require_zulu(t) {
                Ok(_) => assert(false, "offset must Err"),
                Err(msg) => assert(strings.contains(msg, "zulu"), "mentions zulu"),
            }
        },
        Err(_) => assert(false, "parse offset"),
    }
}

@test
fn test_require_midnight() {
    match parse_rfc3339("2024-01-15T00:00:00Z") {
        Ok(t) => {
            match require_midnight(t) {
                Ok(text) => assert(strings.contains(text, "2024"), "keeps year"),
                Err(_) => assert(false, "midnight"),
            }
        },
        Err(_) => assert(false, "parse midnight"),
    }
    match require_midnight(sample_zulu()) {
        Ok(_) => assert(false, "noon must Err"),
        Err(msg) => assert(strings.contains(msg, "midnight"), "mentions midnight"),
    }
}

@test
fn test_require_leap() {
    match require_leap(2024) {
        Ok(year) => assert(is_leap_year(year), "leap"),
        Err(_) => assert(false, "2024 leap"),
    }
    match require_leap(2023) {
        Ok(_) => assert(false, "2023 must Err"),
        Err(msg) => assert(strings.contains(msg, "leap"), "mentions leap"),
    }
}

@test
fn test_require_same_day() {
    match parse_rfc3339("2024-01-15T12:30:00Z") {
        Ok(noon) => {
            match parse_rfc3339("2024-01-15T01:00:00Z") {
                Ok(morning) => {
                    match require_same_day(noon, morning) {
                        Ok(kept) => assert(is_same_day(kept, morning), "same day"),
                        Err(_) => assert(false, "same day ok"),
                    }
                },
                Err(_) => assert(false, "parse morning"),
            }
        },
        Err(_) => assert(false, "parse noon"),
    }
    match parse_rfc3339("2024-01-15T12:30:00Z") {
        Ok(noon) => {
            match parse_rfc3339("2024-01-16T12:30:00Z") {
                Ok(next) => {
                    match require_same_day(noon, next) {
                        Ok(_) => assert(false, "next day must Err"),
                        Err(msg) => assert(strings.contains(msg, "day"), "mentions day"),
                    }
                },
                Err(_) => assert(false, "parse next"),
            }
        },
        Err(_) => assert(false, "parse noon again"),
    }
}

@test
fn test_require_same_month() {
    match parse_rfc3339("2024-01-15T12:30:00Z") {
        Ok(mid) => {
            match parse_rfc3339("2024-01-01T00:00:00Z") {
                Ok(start) => {
                    match require_same_month(mid, start) {
                        Ok(kept) => assert(is_same_month(kept, start), "same month"),
                        Err(_) => assert(false, "same month ok"),
                    }
                },
                Err(_) => assert(false, "parse start"),
            }
        },
        Err(_) => assert(false, "parse mid"),
    }
    match parse_rfc3339("2024-01-15T12:30:00Z") {
        Ok(mid) => {
            match parse_rfc3339("2024-02-01T00:00:00Z") {
                Ok(feb) => {
                    match require_same_month(mid, feb) {
                        Ok(_) => assert(false, "february must Err"),
                        Err(msg) => assert(strings.contains(msg, "month"), "mentions month"),
                    }
                },
                Err(_) => assert(false, "parse feb"),
            }
        },
        Err(_) => assert(false, "parse mid again"),
    }
}

@test
fn test_require_same_year() {
    match parse_rfc3339("2024-01-15T12:30:00Z") {
        Ok(jan) => {
            match parse_rfc3339("2024-12-01T00:00:00Z") {
                Ok(dec) => {
                    match require_same_year(jan, dec) {
                        Ok(kept) => assert(is_same_year(kept, dec), "same year"),
                        Err(_) => assert(false, "same year ok"),
                    }
                },
                Err(_) => assert(false, "parse dec"),
            }
        },
        Err(_) => assert(false, "parse jan"),
    }
    match parse_rfc3339("2024-01-15T12:30:00Z") {
        Ok(jan) => {
            match parse_rfc3339("2023-01-15T12:30:00Z") {
                Ok(prev) => {
                    match require_same_year(jan, prev) {
                        Ok(_) => assert(false, "prior year must Err"),
                        Err(msg) => assert(strings.contains(msg, "year"), "mentions year"),
                    }
                },
                Err(_) => assert(false, "parse prev"),
            }
        },
        Err(_) => assert(false, "parse jan again"),
    }
}

@test
fn test_require_before() {
    match parse_rfc3339("2023-01-15T12:30:00Z") {
        Ok(prev) => {
            match parse_rfc3339("2024-01-15T12:30:00Z") {
                Ok(next) => {
                    match require_before(prev, next) {
                        Ok(kept) => assert(is_before(kept, next), "before"),
                        Err(_) => assert(false, "before ok"),
                    }
                },
                Err(_) => assert(false, "parse next"),
            }
        },
        Err(_) => assert(false, "parse prev"),
    }
    match parse_rfc3339("2024-01-15T12:30:00Z") {
        Ok(next) => {
            match parse_rfc3339("2023-01-15T12:30:00Z") {
                Ok(prev) => {
                    match require_before(next, prev) {
                        Ok(_) => assert(false, "later must Err"),
                        Err(msg) => assert(strings.contains(msg, "before"), "mentions before"),
                    }
                },
                Err(_) => assert(false, "parse prev again"),
            }
        },
        Err(_) => assert(false, "parse next again"),
    }
}

@test
fn test_require_after() {
    match parse_rfc3339("2024-01-15T12:30:00Z") {
        Ok(next) => {
            match parse_rfc3339("2023-01-15T12:30:00Z") {
                Ok(prev) => {
                    match require_after(next, prev) {
                        Ok(kept) => assert(is_after(kept, prev), "after"),
                        Err(_) => assert(false, "after ok"),
                    }
                },
                Err(_) => assert(false, "parse prev"),
            }
        },
        Err(_) => assert(false, "parse next"),
    }
    match parse_rfc3339("2023-01-15T12:30:00Z") {
        Ok(prev) => {
            match parse_rfc3339("2024-01-15T12:30:00Z") {
                Ok(next) => {
                    match require_after(prev, next) {
                        Ok(_) => assert(false, "earlier must Err"),
                        Err(msg) => assert(strings.contains(msg, "after"), "mentions after"),
                    }
                },
                Err(_) => assert(false, "parse next again"),
            }
        },
        Err(_) => assert(false, "parse prev again"),
    }
}
