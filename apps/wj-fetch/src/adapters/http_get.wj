use std::http

use crate::domain::FetchRequest

/// GET `req.url` via `std::http`, with a timeout when `timeout_secs > 0` (adapter boundary).
pub fn fetch_url(req: FetchRequest) -> Result<(u16, string), string> {
    let sent = if req.timeout_secs > 0 {
        http.request("GET", req.url).timeout_secs(req.timeout_secs).send()
    } else {
        http.get(req.url)
    }
    match sent {
        Ok(response) => {
            let status = response.status_code()
            match response.text() {
                Ok(body) => Ok((status, body)),
                Err(e) => Err(e),
            }
        },
        Err(e) => Err(e),
    }
}
