use std::strings
use crate::rng::new_rng
use crate::rng::Rng

pub struct Config {
    /// How many random cases to try.
    pub cases: int,
    /// Seed of the whole run; case `i` uses stream `i`, so any case replays on its own.
    pub seed: int,
    /// Upper bound on shrinking attempts.
    pub max_shrinks: int,
}

pub fn config() -> Config {
    Config { cases: 100, seed: 42, max_shrinks: 1000 }
}

pub fn with_cases(cases: int) -> Config {
    Config { cases: cases, seed: 42, max_shrinks: 1000 }
}

pub fn with_seed(cfg: Config, seed: int) -> Config {
    Config { cases: cfg.cases, seed: seed, max_shrinks: cfg.max_shrinks }
}

/// The result of a run. `failing` is the first input that broke the property, `shrunk` the smallest one found.
pub struct Report {
    pub ok: bool,
    pub cases_run: int,
    pub seed: int,
    pub case: int,
    pub failing: string,
    pub shrunk: string,
    pub shrink_steps: int,
}

fn passed(cfg: Config, run: int) -> Report {
    Report { ok: true, cases_run: run, seed: cfg.seed, case: -1, failing: "", shrunk: "", shrink_steps: 0 }
}

/// A readable failure message with everything needed to replay it.
pub fn describe(r: Report) -> string {
    if r.ok {
        return "ok: ${r.cases_run} cases passed (seed ${r.seed})"
    }
    "property failed after ${r.cases_run} cases (seed ${r.seed}, case ${r.case})\n  first failure: ${r.failing}\n  shrunk to:     ${r.shrunk} (${r.shrink_steps} steps)"
}

/// Fail the surrounding test with the report when the property did not hold.
pub fn assert_holds(r: Report) {
    assert(r.ok, describe(r))
}

fn rng_for(cfg: Config, case: int) -> Rng {
    new_rng(cfg.seed, case)
}

// ---- integers ----

fn int_candidates(n: int, lo: int) -> Vec<int> {
    let mut out: Vec<int> = Vec::new()
    let target = if lo <= 0 { 0 } else { lo }
    if n != target {
        out.push(target)
    }
    let half = target + (n - target) / 2
    if half != n && half != target {
        out.push(half)
    }
    if n > target {
        out.push(n - 1)
    } else if n < target {
        out.push(n + 1)
    }
    out
}

fn shrink_int(cfg: Config, lo: int, start: int, prop: fn(int) -> bool) -> (int, int) {
    let mut best = start
    let mut steps = 0
    let mut progress = true
    while progress && steps < cfg.max_shrinks {
        progress = false
        for c in int_candidates(best, lo) {
            steps = steps + 1
            if !prop(c) {
                best = c
                progress = true
                break
            }
        }
    }
    (best, steps)
}

/// `prop` must hold for integers in `lo..=hi`.
pub fn check_int(cfg: Config, lo: int, hi: int, prop: fn(int) -> bool) -> Report {
    let mut case = 0
    while case < cfg.cases {
        let rng = rng_for(cfg, case)
        let n = rng.range(lo, hi)
        if !prop(n) {
            let (small, steps) = shrink_int(cfg, lo, n, prop)
            return Report { ok: false, cases_run: case + 1, seed: cfg.seed, case: case, failing: "${n}", shrunk: "${small}", shrink_steps: steps }
        }
        case = case + 1
    }
    passed(cfg, cfg.cases)
}

/// `prop` must hold for pairs of integers in `lo..=hi`; each side shrinks on its own.
pub fn check_int_pair(cfg: Config, lo: int, hi: int, prop: fn(int, int) -> bool) -> Report {
    let mut case = 0
    while case < cfg.cases {
        let rng = rng_for(cfg, case)
        let a = rng.range(lo, hi)
        let b = rng.range(lo, hi)
        if !prop(a, b) {
            let mut sa = a
            let mut sb = b
            let mut steps = 0
            let mut progress = true
            while progress && steps < cfg.max_shrinks {
                progress = false
                for c in int_candidates(sa, lo) {
                    steps = steps + 1
                    if !prop(c, sb) {
                        sa = c
                        progress = true
                        break
                    }
                }
                for c in int_candidates(sb, lo) {
                    steps = steps + 1
                    if !prop(sa, c) {
                        sb = c
                        progress = true
                        break
                    }
                }
            }
            return Report { ok: false, cases_run: case + 1, seed: cfg.seed, case: case, failing: "(${a}, ${b})", shrunk: "(${sa}, ${sb})", shrink_steps: steps }
        }
        case = case + 1
    }
    passed(cfg, cfg.cases)
}

// ---- vectors of integers ----

fn show_ints(v: Vec<int>) -> string {
    let mut parts: Vec<string> = Vec::new()
    for x in v {
        parts.push("${x}")
    }
    "[" + parts.join(", ") + "]"
}

fn without(v: Vec<int>, skip: int) -> Vec<int> {
    let mut out: Vec<int> = Vec::new()
    let mut i = 0
    while i < v.len() as int {
        if i != skip {
            out.push(v[i as usize])
        }
        i = i + 1
    }
    out
}

fn with_value(v: Vec<int>, at: int, value: int) -> Vec<int> {
    let mut out: Vec<int> = Vec::new()
    let mut i = 0
    while i < v.len() as int {
        out.push(if i == at { value } else { v[i as usize] })
        i = i + 1
    }
    out
}

fn shrink_ints(cfg: Config, lo: int, start: Vec<int>, prop: fn(Vec<int>) -> bool) -> (Vec<int>, int) {
    let mut best = start
    let mut steps = 0
    let mut progress = true
    while progress && steps < cfg.max_shrinks {
        progress = false
        // First try to drop elements, then to simplify the ones that remain.
        let mut i = 0
        while i < best.len() as int && !progress {
            let cand = without(best, i)
            steps = steps + 1
            if !prop(cand) {
                best = cand
                progress = true
            }
            i = i + 1
        }
        let mut j = 0
        while j < best.len() as int && !progress {
            for c in int_candidates(best[j as usize], lo) {
                let cand = with_value(best, j, c)
                steps = steps + 1
                if !prop(cand) {
                    best = cand
                    progress = true
                    break
                }
            }
            j = j + 1
        }
    }
    (best, steps)
}

/// `prop` must hold for vectors of up to `max_len` integers in `lo..=hi`.
pub fn check_ints(cfg: Config, max_len: int, lo: int, hi: int, prop: fn(Vec<int>) -> bool) -> Report {
    let mut case = 0
    while case < cfg.cases {
        let rng = rng_for(cfg, case)
        let len = rng.range(0, max_len)
        let mut v: Vec<int> = Vec::new()
        let mut i = 0
        while i < len {
            v.push(rng.range(lo, hi))
            i = i + 1
        }
        if !prop(v) {
            let (small, steps) = shrink_ints(cfg, lo, v, prop)
            return Report { ok: false, cases_run: case + 1, seed: cfg.seed, case: case, failing: show_ints(v), shrunk: show_ints(small), shrink_steps: steps }
        }
        case = case + 1
    }
    passed(cfg, cfg.cases)
}

// ---- strings ----

fn shrink_string(cfg: Config, start: string, simplest: string, prop: fn(string) -> bool) -> (string, int) {
    let mut best = start
    let mut steps = 0
    let mut progress = true
    while progress && steps < cfg.max_shrinks {
        progress = false
        let n = strings.len(best)
        let mut i = 0
        while i < n && !progress {
            let cand = strings.substring(best, 0, i) + strings.substring(best, i + 1, n)
            steps = steps + 1
            if !prop(cand) {
                best = cand
                progress = true
            }
            i = i + 1
        }
        let mut j = 0
        while j < strings.len(best) && !progress {
            if strings.substring(best, j, j + 1) != simplest {
                let cand = strings.substring(best, 0, j) + simplest + strings.substring(best, j + 1, strings.len(best))
                steps = steps + 1
                if !prop(cand) {
                    best = cand
                    progress = true
                }
            }
            j = j + 1
        }
    }
    (best, steps)
}

/// `prop` must hold for strings of up to `max_len` characters drawn from `alphabet` (a string of ASCII characters).
pub fn check_string(cfg: Config, max_len: int, alphabet: string, prop: fn(string) -> bool) -> Report {
    let letters = strings.len(alphabet)
    let simplest = strings.substring(alphabet, 0, 1)
    let mut case = 0
    while case < cfg.cases {
        let rng = rng_for(cfg, case)
        let len = rng.range(0, max_len)
        let mut s = ""
        let mut i = 0
        while i < len {
            let at = rng.below(letters)
            s = s + strings.substring(alphabet, at, at + 1)
            i = i + 1
        }
        if !prop(s) {
            let (small, steps) = shrink_string(cfg, s, simplest, prop)
            return Report { ok: false, cases_run: case + 1, seed: cfg.seed, case: case, failing: "\"${s}\"", shrunk: "\"${small}\"", shrink_steps: steps }
        }
        case = case + 1
    }
    passed(cfg, cfg.cases)
}
