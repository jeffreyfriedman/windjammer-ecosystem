use crate::domain::SchedulerConfig
use crate::domain::is_day_budget
use crate::domain::max_minutes_of
use crate::domain::require_day_budget
use std::strings

fn test_config_defaults_and_accessors() {
    let cfg = SchedulerConfig::defaults()
    assert_eq(max_minutes_of(cfg), 1440)
    assert(is_day_budget(SchedulerConfig::defaults()), "day budget")
}

fn test_require_day_budget() {
    match require_day_budget(SchedulerConfig::defaults()) {
        Ok(mins) => assert_eq(mins, 1440),
        Err(_) => assert(false, "default day budget"),
    }
    let mut cfg = SchedulerConfig::defaults()
    cfg.default_max_minutes = 60
    match require_day_budget(cfg) {
        Ok(_) => assert(false, "hour budget must Err"),
        Err(msg) => assert(strings.contains(msg, "day"), "mentions day"),
    }
}
