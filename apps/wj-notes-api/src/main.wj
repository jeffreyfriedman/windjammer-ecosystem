use crate::domain::NoteStore
use crate::domain::parse_positive_int
use crate::adapters::serve
use std::env

fn main() {
    let port = port_from_env()
    let store = NoteStore::new()
    println("wj-notes-api listening on http://0.0.0.0:${port}")
    match serve(port, store) {
        Ok(_) => {},
        Err(err) => println("wj-notes-api error: ${err}"),
    }
}

fn port_from_env() -> int {
    match env.get("PORT") {
        Some(value) => {
            match parse_positive_int(value) {
                Some(port) => port,
                None => 8080,
            }
        },
        None => 8080,
    }
}
