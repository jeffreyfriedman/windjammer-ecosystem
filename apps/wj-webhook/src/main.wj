// Composition root — env config + HTTP adapter + webhook domain.

use crate::adapters::serve
use std::env
use std::strings

fn main() {
    let secret = secret_from_env()
    let port = port_from_env()
    println("wj-webhook listening on http://0.0.0.0:${port}")
    match serve(port, secret) {
        Ok(_) => {},
        Err(err) => println("wj-webhook error: ${err}"),
    }
}

fn secret_from_env() -> string {
    match env.get("WEBHOOK_SECRET") {
        Some(value) => value,
        None => "dev-secret",
    }
}

fn port_from_env() -> int {
    match env.get("PORT") {
        Some(value) => {
            match parse_positive_int(value) {
                Some(port) => port,
                None => 8090,
            }
        },
        None => 8090,
    }
}

fn parse_positive_int(text: string) -> Option<int> {
    if text.len() == 0 {
        return None
    }
    let mut total: int = 0
    for ch in strings.chars(text) {
        match char_to_digit(ch) {
            Some(digit) => {
                total = total * 10 + digit
            },
            None => return None,
        }
    }
    if total < 1 {
        return None
    }
    Some(total)
}

fn char_to_digit(ch: char) -> Option<int> {
    if ch == '0' { return Some(0) }
    if ch == '1' { return Some(1) }
    if ch == '2' { return Some(2) }
    if ch == '3' { return Some(3) }
    if ch == '4' { return Some(4) }
    if ch == '5' { return Some(5) }
    if ch == '6' { return Some(6) }
    if ch == '7' { return Some(7) }
    if ch == '8' { return Some(8) }
    if ch == '9' { return Some(9) }
    None
}
