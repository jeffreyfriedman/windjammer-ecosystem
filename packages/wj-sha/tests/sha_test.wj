use crate::digest_hex_len
use crate::etag
use crate::hex
use crate::looks_like_sha256_hex
use crate::normalize_hex
use crate::verify
use crate::verify_etag

@test
fn test_sha256_hello() {
    let digest = hex("hello")
    assert_eq(digest, "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824")
}

@test
fn test_sha256_empty() {
    let digest = hex("")
    assert_eq(digest, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
}

@test
fn test_verify_true() {
    assert(verify("hello", "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"), "expected match")
}

@test
fn test_verify_false() {
    assert(!verify("hello", "deadbeef"), "expected mismatch")
}

@test
fn test_etag_quoted_digest() {
    assert_eq(
        etag("hello"),
        "\"2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824\""
    )
}

@test
fn test_looks_like_sha256_hex() {
    let digest = hex("hello")
    assert(looks_like_sha256_hex(digest), "real digest")
    assert(!looks_like_sha256_hex("deadbeef"), "too short")
    assert(!looks_like_sha256_hex(""), "empty")
    assert(!looks_like_sha256_hex("2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b982g"), "non-hex")
}

@test
fn test_normalize_hex_and_digest_len() {
    assert_eq(digest_hex_len(), 64)
    assert_eq(normalize_hex("ABCD"), "abcd")
    assert(looks_like_sha256_hex(normalize_hex(hex("hello"))), "normalized digest")
}

@test
fn test_verify_etag() {
    let tag = etag("hello")
    assert(verify_etag("hello", tag), "match")
    assert(!verify_etag("hello", "\"deadbeef\""), "mismatch")
    assert(!verify_etag("hello", "unquoted"), "needs quotes")
}
