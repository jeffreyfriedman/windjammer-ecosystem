use crate::Backoff
use crate::attempts_remaining
use crate::attempts_used
use crate::clamp_delay_ms
use crate::default_backoff
use crate::delay_ms
use crate::is_default_backoff
use crate::is_exhausted
use crate::new_backoff
use crate::retry_delay
use crate::should_retry
use crate::total_delay_ms
use crate::pause_ms
use crate::initial_of
use crate::max_of
use crate::multiplier_of
use crate::with_initial_ms
use crate::with_max_ms
use crate::with_multiplier
use std::strings

fn test_delay_ms_exponential() {
    let b = Backoff {
        initial_ms: 100,
        multiplier: 2,
        max_ms: 1000,
    }
    assert_eq(delay_ms(b, 0), 100)
    assert_eq(delay_ms(b, 1), 200)
    assert_eq(delay_ms(b, 2), 400)
    assert_eq(delay_ms(b, 3), 800)
    assert_eq(delay_ms(b, 4), 1000)
    assert_eq(delay_ms(b, 5), 1000)
}

fn test_delay_ms_zero_attempt() {
    let b = Backoff {
        initial_ms: 50,
        multiplier: 3,
        max_ms: 500,
    }
    assert_eq(delay_ms(b, 0), 50)
}

fn test_should_retry_respects_max_attempts() {
    assert(should_retry(0, 3), "attempt 0 of 3")
    assert(should_retry(2, 3), "attempt 2 of 3")
    assert(!should_retry(3, 3), "attempt 3 of 3")
    assert(!should_retry(4, 3), "attempt 4 of 3")
}

fn test_should_retry_zero_max() {
    assert(!should_retry(0, 0), "max 0")
}

fn test_pause_ms_zero_is_noop() {
    pause_ms(0)
}

fn test_retry_delay_some_while_retries_remain() {
    let b = Backoff {
        initial_ms: 100,
        multiplier: 2,
        max_ms: 1000,
    }
    match retry_delay(b, 0, 3) {
        Some(ms) => assert_eq(ms, 100),
        None => assert(false, "attempt 0 should retry"),
    }
    match retry_delay(b, 2, 3) {
        Some(ms) => assert_eq(ms, 400),
        None => assert(false, "attempt 2 should retry"),
    }
}

fn test_retry_delay_none_when_exhausted() {
    let b = Backoff {
        initial_ms: 100,
        multiplier: 2,
        max_ms: 1000,
    }
    match retry_delay(b, 3, 3) {
        Some(_) => assert(false, "exhausted"),
        None => {},
    }
}

fn test_attempts_remaining() {
    assert_eq(attempts_remaining(0, 3), 3)
    assert_eq(attempts_remaining(2, 3), 1)
    assert_eq(attempts_remaining(3, 3), 0)
    assert_eq(attempts_remaining(5, 3), 0)
    assert_eq(attempts_remaining(0, 0), 0)
}

fn test_default_backoff() {
    let b = default_backoff()
    assert_eq(b.initial_ms, 100)
    assert_eq(b.multiplier, 2)
    assert_eq(b.max_ms, 30000)
    assert_eq(delay_ms(b, 0), 100)
    assert_eq(delay_ms(b, 1), 200)
}

fn test_is_exhausted() {
    assert(!is_exhausted(0, 3), "first attempt")
    assert(!is_exhausted(2, 3), "last in-range")
    assert(is_exhausted(3, 3), "at max")
    assert(is_exhausted(0, 0), "zero max")
}

fn test_total_delay_ms() {
    let b = Backoff {
        initial_ms: 100,
        multiplier: 2,
        max_ms: 1000,
    }
    // attempts 0..2 → 100 + 200 + 400
    assert_eq(total_delay_ms(b, 3), 700)
    assert_eq(total_delay_ms(b, 0), 0)
    assert_eq(total_delay_ms(b, 1), 100)
}

fn test_clamp_delay_ms() {
    assert_eq(clamp_delay_ms(50, 100, 1000), 100)
    assert_eq(clamp_delay_ms(500, 100, 1000), 500)
    assert_eq(clamp_delay_ms(5000, 100, 1000), 1000)
}

fn test_with_max_ms() {
    let b = default_backoff()
    let capped = with_max_ms(b, 250)
    assert_eq(capped.initial_ms, 100)
    assert_eq(capped.multiplier, 2)
    assert_eq(capped.max_ms, 250)
    assert_eq(delay_ms(capped, 3), 250)
}

fn test_with_initial_ms() {
    let b = default_backoff()
    let bumped = with_initial_ms(b, 50)
    assert_eq(bumped.initial_ms, 50)
    assert_eq(bumped.multiplier, 2)
    assert_eq(bumped.max_ms, 30000)
    assert_eq(delay_ms(bumped, 0), 50)
}

fn test_with_multiplier_and_accessors() {
    let b = default_backoff()
    assert_eq(initial_of(b), 100)
    assert_eq(multiplier_of(b), 2)
    assert_eq(max_of(b), 30000)
    let scaled = with_multiplier(b, 3)
    assert_eq(multiplier_of(scaled), 3)
    assert_eq(initial_of(scaled), 100)
    assert_eq(delay_ms(scaled, 1), 300)
}

fn test_new_backoff_is_default_and_attempts_used() {
    let custom = new_backoff(50, 3, 5000)
    assert_eq(initial_of(custom), 50)
    assert_eq(multiplier_of(custom), 3)
    assert_eq(max_of(custom), 5000)
    assert(is_default_backoff(default_backoff()), "defaults")
    assert(!is_default_backoff(custom), "custom")
    assert_eq(attempts_used(0, 5), 0)
    assert_eq(attempts_used(2, 5), 2)
    assert_eq(attempts_used(5, 5), 5)
    assert_eq(attempts_used(9, 5), 5)
}

fn test_first_next_and_retries_left() {
    use crate::has_retries_left
    use crate::is_first_attempt
    use crate::next_attempt
    assert(is_first_attempt(0), "zero")
    assert(!is_first_attempt(1), "later")
    assert(!is_first_attempt(-1), "negative")
    assert_eq(next_attempt(0), 1)
    assert_eq(next_attempt(4), 5)
    assert(has_retries_left(0, 3), "start")
    assert(has_retries_left(2, 3), "one left")
    assert(!has_retries_left(3, 3), "exhausted")
    assert(!has_retries_left(0, 0), "zero max")
}

fn test_require_retry() {
    use crate::require_retry
    match require_retry(0, 3) {
        Ok(left) => assert_eq(left, 3),
        Err(_) => assert(false, "retries remain"),
    }
    match require_retry(3, 3) {
        Ok(_) => assert(false, "exhausted must Err"),
        Err(msg) => assert(strings.contains(msg, "retry"), "mentions retry"),
    }
}
