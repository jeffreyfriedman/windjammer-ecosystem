pub struct Summary {
    pub name: string,
    pub count: int,
}

fn items(n: int) -> Result<Vec<int>, string> {
    if n < 0 {
        return Err("negative")
    }
    let mut v: Vec<int> = Vec::new()
    let mut i = 0
    while i < n {
        v.push(i)
        i = i + 1
    }
    Ok(v)
}

/// `items(n)?.len() as int` as a struct field: the interpreter reports `a Result has no method __opt_chain`.
pub fn summarize(n: int) -> Result<Summary, string> {
    Ok(Summary { name: "x", count: items(n)?.len() as int })
}
