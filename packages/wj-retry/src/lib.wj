use std::time

/// Exponential backoff parameters (milliseconds).
pub struct Backoff {
    pub initial_ms: int,
    pub multiplier: int,
    pub max_ms: int,
}

/// Delay before attempt `n` (0-based): `min(initial * multiplier^n, max)`.
pub fn delay_ms(backoff: Backoff, attempt: int) -> int {
    if attempt < 0 {
        return backoff.initial_ms
    }
    let mut delay = backoff.initial_ms
    let mut i = 0
    while i < attempt {
        delay = delay * backoff.multiplier
        if delay >= backoff.max_ms {
            return backoff.max_ms
        }
        i = i + 1
    }
    if delay > backoff.max_ms {
        return backoff.max_ms
    }
    delay
}

/// True when `attempt` (0-based) is still within `max_attempts` tries.
pub fn should_retry(attempt: int, max_attempts: int) -> bool {
    if max_attempts <= 0 {
        return false
    }
    attempt < max_attempts
}

/// Delay for `attempt` when retries remain; `None` when `should_retry` is false.
pub fn retry_delay(backoff: Backoff, attempt: int, max_attempts: int) -> Option<int> {
    if !should_retry(attempt, max_attempts) {
        return None
    }
    Some(delay_ms(backoff, attempt))
}

/// How many tries remain including the current `attempt` (0-based).
/// Returns 0 when exhausted or when `max_attempts` is non-positive.
pub fn attempts_remaining(attempt: int, max_attempts: int) -> int {
    if max_attempts <= 0 {
        return 0
    }
    if attempt >= max_attempts {
        return 0
    }
    max_attempts - attempt
}

/// Sensible HTTP/client defaults: 100ms ×2, cap 30s.
pub fn default_backoff() -> Backoff {
    Backoff {
        initial_ms: 100,
        multiplier: 2,
        max_ms: 30000,
    }
}

/// Blocking pause between retry attempts (milliseconds).
/// Uses `std::time` spin-wait until `std::async_runtime::sleep_ms_blocking` import codegen is fixed.
pub fn pause_ms(ms: int) {
    if ms <= 0 {
        return
    }
    let start = time.utc_now().timestamp_millis()
    let deadline = start + ms
    let mut now = start
    while now < deadline {
        now = time.utc_now().timestamp_millis()
    }
}
