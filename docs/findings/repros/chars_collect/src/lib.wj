use std::strings

/// `strings.chars(..)` is an iterator interpreted and a Vec<char> compiled, so `.collect()` only works interpreted.
pub fn count_a(text: string) -> int {
    let cs: Vec<char> = strings.chars(text).collect()
    let mut n = 0
    for c in cs {
        if c == 'a' {
            n = n + 1
        }
    }
    n
}
