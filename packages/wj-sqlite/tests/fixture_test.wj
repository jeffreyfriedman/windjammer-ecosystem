        "20353220636166c3a920e29c933415032f016974656d20353020636166c3a920e29c933214032d016974656d203520636166c3a920e29c930515032f016974656d20343920636166c3a920e29c933115",
        "032f016974656d20343720636166c3a920e29c932f"
    ])
}

fn mismatches(table: string, expected: Vec<string>) -> string {
    let db = match open(fixture()) {
        Ok(d) => d,
        Err(e) => return "open: ${e}",
    }
    let rows = match db.rows(table) {
        Ok(r) => r,
        Err(e) => return "rows: ${e}",
    }
    if rows.len() != expected.len() {
        return "${table}: ${rows.len()} rows, expected ${expected.len()}"
    }
    let mut bad = ""
    let mut i = 0
    while i < expected.len() {
        let specs = expected[i].split("\u{1f}").collect()
        if !row_matches(rows[i].values, specs) {
            bad = bad + "row ${i + 1} differs; "
        }
        i = i + 1
    }
    bad
}

