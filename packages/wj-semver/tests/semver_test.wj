use crate::SemVer
use crate::parse
use crate::build_of
use crate::compare
use crate::format_version
use crate::has_build
use crate::has_prerelease
use crate::is_compatible
use crate::is_equal
use crate::is_newer
use crate::is_older
use crate::is_prerelease
use crate::is_zero_version
use crate::bump_major
use crate::bump_minor
use crate::bump_patch
use crate::clear_prerelease
use crate::clear_build
use crate::is_stable
use crate::is_zero_major
use crate::major_of
use crate::require_stable
use crate::require_build
use crate::require_prerelease
use crate::require_zero_major
use crate::require_zero_version
use crate::require_older
use crate::require_newer
use crate::require_equal
use std::strings
use crate::minor_of
use crate::patch_of
use crate::prerelease_of

fn test_parse_simple_version() {
    match parse("1.2.3") {
        Ok(v) => {
            assert_eq(v.major, 1)
            assert_eq(v.minor, 2)
            assert_eq(v.patch, 3)
            assert_eq(v.pre, "")
            assert_eq(v.build, "")
        },
        Err(_) => assert(false, "parse 1.2.3"),
    }
}

fn test_parse_with_prerelease_and_build() {
    match parse("1.0.0-alpha.1+build.5") {
        Ok(v) => {
            assert_eq(v.major, 1)
            assert_eq(v.pre, "alpha.1")
            assert_eq(v.build, "build.5")
        },
        Err(_) => assert(false, "parse prerelease"),
    }
}

fn test_parse_rejects_empty() {
    match parse("") {
        Ok(_) => assert(false, "expected Err"),
        Err(_) => {},
    }
}

fn test_compare_ordering() {
    match parse("1.0.0") {
        Ok(a) => {
            match parse("2.0.0") {
                Ok(b) => assert_eq(compare(a, b), -1),
                Err(_) => assert(false, "parse b"),
            }
        },
        Err(_) => assert(false, "parse a"),
    }
    match parse("1.2.3") {
        Ok(a) => {
            match parse("1.2.4") {
                Ok(b) => assert_eq(compare(a, b), -1),
                Err(_) => assert(false, "parse patch"),
            }
        },
        Err(_) => assert(false, "parse a2"),
    }
    match parse("1.0.0") {
        Ok(a) => {
            match parse("1.0.0") {
                Ok(b) => assert_eq(compare(a, b), 0),
                Err(_) => assert(false, "parse b same"),
            }
        },
        Err(_) => assert(false, "parse same"),
    }
}

fn test_prerelease_is_older_than_release() {
    match parse("1.0.0-alpha") {
        Ok(pre) => {
            match parse("1.0.0") {
                Ok(rel) => assert_eq(compare(pre, rel), -1),
                Err(_) => assert(false, "parse rel"),
            }
        },
        Err(_) => assert(false, "parse pre"),
    }
}

fn test_format_version_roundtrip() {
    match parse("3.4.5-beta.2+meta") {
        Ok(v) => assert_eq(format_version(v), "3.4.5-beta.2+meta"),
        Err(_) => assert(false, "parse roundtrip"),
    }
}

fn test_is_newer() {
    match parse("1.2.4") {
        Ok(a) => {
            match parse("1.2.3") {
                Ok(b) => {
                    assert(is_newer(a, b), "patch bump is newer")
                    assert(!is_newer(b, a), "older is not newer")
                },
                Err(_) => assert(false, "parse b"),
            }
        },
        Err(_) => assert(false, "parse a"),
    }
}

fn test_is_compatible_same_major() {
    match parse("1.2.3") {
        Ok(a) => {
            match parse("1.9.0") {
                Ok(b) => assert(is_compatible(a, b), "same major"),
                Err(_) => assert(false, "parse b"),
            }
            match parse("2.0.0") {
                Ok(c) => assert(!is_compatible(a, c), "major bump breaks"),
                Err(_) => assert(false, "parse c"),
            }
        },
        Err(_) => assert(false, "parse a"),
    }
}

fn test_is_equal_ignores_build() {
    match parse("1.2.3+build1") {
        Ok(a) => {
            match parse("1.2.3+build2") {
                Ok(b) => assert(is_equal(a, b), "build ignored"),
                Err(_) => assert(false, "parse b"),
            }
            match parse("1.2.4") {
                Ok(c) => assert(!is_equal(a, c), "patch differs"),
                Err(_) => assert(false, "parse c"),
            }
        },
        Err(_) => assert(false, "parse a"),
    }
}

fn test_is_older() {
    match parse("1.2.3") {
        Ok(a) => {
            match parse("1.2.4") {
                Ok(b) => {
                    assert(is_older(a, b), "older")
                    assert(!is_older(b, a), "newer not older")
                },
                Err(_) => assert(false, "parse b"),
            }
        },
        Err(_) => assert(false, "parse a"),
    }
}

fn test_has_prerelease_and_build() {
    match parse("1.0.0-alpha+meta") {
        Ok(v) => {
            assert(has_prerelease(v), "pre")
            assert(has_build(v), "build")
        },
        Err(_) => assert(false, "parse"),
    }
    match parse("1.0.0") {
        Ok(v) => {
            assert(!has_prerelease(v), "no pre")
            assert(!has_build(v), "no build")
        },
        Err(_) => assert(false, "parse release"),
    }
}

fn test_bump_patch() {
    match parse("1.2.3-beta+meta") {
        Ok(v) => {
            let next = bump_patch(v)
            assert_eq(next.major, 1)
            assert_eq(next.minor, 2)
            assert_eq(next.patch, 4)
            assert_eq(next.pre, "")
            assert_eq(next.build, "")
            assert_eq(format_version(next), "1.2.4")
        },
        Err(_) => assert(false, "parse"),
    }
}

fn test_bump_minor_and_major() {
    match parse("1.2.3-beta+meta") {
        Ok(v) => {
            let minor = bump_minor(v)
            assert_eq(format_version(minor), "1.3.0")
            let major = bump_major(v)
            assert_eq(format_version(major), "2.0.0")
        },
        Err(_) => assert(false, "parse"),
    }
}

fn test_clear_prerelease() {
    match parse("1.2.3-rc.1+build") {
        Ok(v) => {
            let cleared = clear_prerelease(v)
            assert_eq(format_version(cleared), "1.2.3+build")
            assert(!has_prerelease(cleared), "pre cleared")
            assert(has_build(cleared), "build kept")
        },
        Err(_) => assert(false, "parse"),
    }
}

fn test_clear_build() {
    match parse("1.2.3-rc.1+build") {
        Ok(v) => {
            let cleared = clear_build(v)
            assert_eq(format_version(cleared), "1.2.3-rc.1")
            assert(has_prerelease(cleared), "pre kept")
            assert(!has_build(cleared), "build cleared")
        },
        Err(_) => assert(false, "parse"),
    }
}

fn test_is_stable() {
    match parse("1.2.3") {
        Ok(v) => assert(is_stable(v), "release is stable"),
        Err(_) => assert(false, "parse release"),
    }
    match parse("1.2.3-beta") {
        Ok(v) => assert(!is_stable(v), "prerelease not stable"),
        Err(_) => assert(false, "parse pre"),
    }
    match parse("1.2.3+meta") {
        Ok(v) => assert(is_stable(v), "build-only still stable"),
        Err(_) => assert(false, "parse build"),
    }
}

fn sample_ver() -> SemVer {
    match parse("1.2.3") {
        Ok(v) => v,
        Err(_) => SemVer { major: 0, minor: 0, patch: 0, pre: "", build: "" },
    }
}

fn test_component_accessors_and_zero() {
    assert_eq(major_of(sample_ver()), 1)
    assert_eq(minor_of(sample_ver()), 2)
    assert_eq(patch_of(sample_ver()), 3)
    assert(!is_zero_version(sample_ver()), "not zero")
    match parse("0.0.0") {
        Ok(v) => assert(is_zero_version(v), "zero"),
        Err(_) => assert(false, "parse zero"),
    }
}

fn test_prerelease_build_accessors() {
    match parse("1.2.3-beta.1+build.9") {
        Ok(v) => {
            assert_eq(prerelease_of(v), "beta.1")
            assert_eq(build_of(v), "build.9")
            assert(is_prerelease(v), "pre")
            assert(!is_stable(v), "not stable")
        },
        Err(_) => assert(false, "parse"),
    }
    match parse("1.2.3") {
        Ok(v) => {
            assert_eq(prerelease_of(v), "")
            assert_eq(build_of(v), "")
            assert(!is_prerelease(v), "release")
        },
        Err(_) => assert(false, "parse release"),
    }
}

fn test_is_zero_major_and_require_stable() {
    match parse("0.1.0") {
        Ok(v) => assert(is_zero_major(v), "zero major"),
        Err(_) => assert(false, "parse 0.1.0"),
    }
    match parse("1.0.0") {
        Ok(v) => assert(!is_zero_major(v), "one major"),
        Err(_) => assert(false, "parse 1.0.0"),
    }
    match parse("1.2.3+meta") {
        Ok(v) => {
            match require_stable(v) {
                Ok(stable) => assert(is_stable(stable), "stable"),
                Err(_) => assert(false, "build-only is stable"),
            }
        },
        Err(_) => assert(false, "parse build"),
    }
    match parse("1.2.3-beta") {
        Ok(v) => {
            match require_stable(v) {
                Ok(_) => assert(false, "prerelease must Err"),
                Err(msg) => assert(strings.contains(msg, "stable"), "mentions stable"),
            }
        },
        Err(_) => assert(false, "parse pre"),
    }
}

fn test_require_prerelease() {
    match parse("1.2.3-beta.1") {
        Ok(v) => {
            match require_prerelease(v) {
                Ok(pre) => assert_eq(pre, "beta.1"),
                Err(_) => assert(false, "prerelease"),
            }
        },
        Err(_) => assert(false, "parse beta"),
    }
    match parse("1.2.3") {
        Ok(v) => {
            match require_prerelease(v) {
                Ok(_) => assert(false, "release must Err"),
                Err(msg) => assert(strings.contains(msg, "prerelease"), "mentions prerelease"),
            }
        },
        Err(_) => assert(false, "parse release"),
    }
}

fn test_require_build() {
    match parse("1.2.3+build.5") {
        Ok(v) => {
            match require_build(v) {
                Ok(build) => assert_eq(build, "build.5"),
                Err(_) => assert(false, "build"),
            }
        },
        Err(_) => assert(false, "parse build"),
    }
    match parse("1.2.3") {
        Ok(v) => {
            match require_build(v) {
                Ok(_) => assert(false, "plain must Err"),
                Err(msg) => assert(strings.contains(msg, "build"), "mentions build"),
            }
        },
        Err(_) => assert(false, "parse plain"),
    }
}

fn test_require_zero_major() {
    match parse("0.1.0") {
        Ok(v) => {
            match require_zero_major(v) {
                Ok(parsed) => assert(is_zero_major(parsed), "zero"),
                Err(_) => assert(false, "zero major"),
            }
        },
        Err(_) => assert(false, "parse zero"),
    }
    match parse("1.2.3") {
        Ok(v) => {
            match require_zero_major(v) {
                Ok(_) => assert(false, "one major must Err"),
                Err(msg) => assert(strings.contains(msg, "zero"), "mentions zero"),
            }
        },
        Err(_) => assert(false, "parse one"),
    }
}

fn test_require_zero_version() {
    match parse("0.0.0") {
        Ok(v) => {
            match require_zero_version(v) {
                Ok(parsed) => assert(is_zero_version(parsed), "zero"),
                Err(_) => assert(false, "zero version"),
            }
        },
        Err(_) => assert(false, "parse zero"),
    }
    match parse("0.1.0") {
        Ok(v) => {
            match require_zero_version(v) {
                Ok(_) => assert(false, "minor must Err"),
                Err(msg) => assert(strings.contains(msg, "version"), "mentions version"),
            }
        },
        Err(_) => assert(false, "parse minor"),
    }
}

fn test_require_older() {
    match parse("1.0.0") {
        Ok(older) => {
            match parse("2.0.0") {
                Ok(newer) => {
                    match require_older(older, newer) {
                        Ok(kept) => assert(is_older(kept, newer), "older"),
                        Err(_) => assert(false, "older ok"),
                    }
                },
                Err(_) => assert(false, "parse newer"),
            }
        },
        Err(_) => assert(false, "parse older"),
    }
    match parse("2.0.0") {
        Ok(newer) => {
            match parse("1.0.0") {
                Ok(older) => {
                    match require_older(newer, older) {
                        Ok(_) => assert(false, "newer must Err"),
                        Err(msg) => assert(strings.contains(msg, "older"), "mentions older"),
                    }
                },
                Err(_) => assert(false, "parse older again"),
            }
        },
        Err(_) => assert(false, "parse newer again"),
    }
}

fn test_require_newer() {
    match parse("2.0.0") {
        Ok(newer) => {
            match parse("1.0.0") {
                Ok(older) => {
                    match require_newer(newer, older) {
                        Ok(kept) => assert(is_newer(kept, older), "newer"),
                        Err(_) => assert(false, "newer ok"),
                    }
                },
                Err(_) => assert(false, "parse older"),
            }
        },
        Err(_) => assert(false, "parse newer"),
    }
    match parse("1.0.0") {
        Ok(older) => {
            match parse("2.0.0") {
                Ok(newer) => {
                    match require_newer(older, newer) {
                        Ok(_) => assert(false, "older must Err"),
                        Err(msg) => assert(strings.contains(msg, "newer"), "mentions newer"),
                    }
                },
                Err(_) => assert(false, "parse newer again"),
            }
        },
        Err(_) => assert(false, "parse older again"),
    }
}

fn test_require_equal() {
    match parse("1.2.3") {
        Ok(left) => {
            match parse("1.2.3") {
                Ok(right) => {
                    match require_equal(left, right) {
                        Ok(kept) => assert(is_equal(kept, right), "equal"),
                        Err(_) => assert(false, "equal ok"),
                    }
                },
                Err(_) => assert(false, "parse right"),
            }
        },
        Err(_) => assert(false, "parse left"),
    }
    match parse("1.2.3") {
        Ok(left) => {
            match parse("1.2.4") {
                Ok(right) => {
                    match require_equal(left, right) {
                        Ok(_) => assert(false, "mismatch must Err"),
                        Err(msg) => assert(strings.contains(msg, "equal"), "mentions equal"),
                    }
                },
                Err(_) => assert(false, "parse right again"),
            }
        },
        Err(_) => assert(false, "parse left again"),
    }
}
