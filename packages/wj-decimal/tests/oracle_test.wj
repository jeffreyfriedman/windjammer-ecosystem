// Expected values come from Python's decimal module (getcontext().prec = 60, quantize with the ROUND_* mode of the same name).
use crate::Decimal
use crate::Rounding
use crate::add
use crate::allocate
use crate::compare
use crate::div
use crate::equals
use crate::format_places
use crate::mul
use crate::new
use crate::parse
use crate::rescale
use crate::sub
use crate::to_string
use crate::with_thousands

fn mode_named(name: string) -> Rounding {
    if name == "Down" { return Rounding::Down }
    if name == "Up" { return Rounding::Up }
    if name == "Floor" { return Rounding::Floor }
    if name == "Ceiling" { return Rounding::Ceiling }
    if name == "HalfUp" { return Rounding::HalfUp }
    if name == "HalfDown" { return Rounding::HalfDown }
    Rounding::HalfEven
}

fn dec(text: string) -> Decimal {
    match parse(text) {
        Ok(d) => d,
        Err(e) => {
            assert(false, "parse ${text}: ${e}")
            new(0, 0)
        },
    }
}

fn text_of(r: Result<Decimal, string>) -> string {
    match r {
        Ok(d) => to_string(d),
        Err(e) => "error: ${e}",
    }
}

@test
fn test_rescale_matches_python_quantize() {
    assert_eq(text_of(rescale(dec("2.5"), 0, mode_named("Down"))), "2")
    assert_eq(text_of(rescale(dec("2.5"), 0, mode_named("Up"))), "3")
    assert_eq(text_of(rescale(dec("2.5"), 0, mode_named("Floor"))), "2")
    assert_eq(text_of(rescale(dec("2.5"), 0, mode_named("Ceiling"))), "3")
    assert_eq(text_of(rescale(dec("2.5"), 0, mode_named("HalfUp"))), "3")
    assert_eq(text_of(rescale(dec("2.5"), 0, mode_named("HalfDown"))), "2")
    assert_eq(text_of(rescale(dec("2.5"), 0, mode_named("HalfEven"))), "2")
    assert_eq(text_of(rescale(dec("2.5"), 1, mode_named("Down"))), "2.5")
    assert_eq(text_of(rescale(dec("2.5"), 1, mode_named("Up"))), "2.5")
    assert_eq(text_of(rescale(dec("2.5"), 1, mode_named("Floor"))), "2.5")
    assert_eq(text_of(rescale(dec("2.5"), 1, mode_named("Ceiling"))), "2.5")
    assert_eq(text_of(rescale(dec("2.5"), 1, mode_named("HalfUp"))), "2.5")
    assert_eq(text_of(rescale(dec("2.5"), 1, mode_named("HalfDown"))), "2.5")
    assert_eq(text_of(rescale(dec("2.5"), 1, mode_named("HalfEven"))), "2.5")
    assert_eq(text_of(rescale(dec("2.5"), 2, mode_named("Down"))), "2.50")
    assert_eq(text_of(rescale(dec("2.5"), 2, mode_named("Up"))), "2.50")
    assert_eq(text_of(rescale(dec("2.5"), 2, mode_named("Floor"))), "2.50")
    assert_eq(text_of(rescale(dec("2.5"), 2, mode_named("Ceiling"))), "2.50")
    assert_eq(text_of(rescale(dec("2.5"), 2, mode_named("HalfUp"))), "2.50")
    assert_eq(text_of(rescale(dec("2.5"), 2, mode_named("HalfDown"))), "2.50")
    assert_eq(text_of(rescale(dec("2.5"), 2, mode_named("HalfEven"))), "2.50")
    assert_eq(text_of(rescale(dec("-2.5"), 0, mode_named("Down"))), "-2")
    assert_eq(text_of(rescale(dec("-2.5"), 0, mode_named("Up"))), "-3")
    assert_eq(text_of(rescale(dec("-2.5"), 0, mode_named("Floor"))), "-3")
    assert_eq(text_of(rescale(dec("-2.5"), 0, mode_named("Ceiling"))), "-2")
    assert_eq(text_of(rescale(dec("-2.5"), 0, mode_named("HalfUp"))), "-3")
    assert_eq(text_of(rescale(dec("-2.5"), 0, mode_named("HalfDown"))), "-2")
    assert_eq(text_of(rescale(dec("-2.5"), 0, mode_named("HalfEven"))), "-2")
    assert_eq(text_of(rescale(dec("-2.5"), 1, mode_named("Down"))), "-2.5")
    assert_eq(text_of(rescale(dec("-2.5"), 1, mode_named("Up"))), "-2.5")
    assert_eq(text_of(rescale(dec("-2.5"), 1, mode_named("Floor"))), "-2.5")
    assert_eq(text_of(rescale(dec("-2.5"), 1, mode_named("Ceiling"))), "-2.5")
    assert_eq(text_of(rescale(dec("-2.5"), 1, mode_named("HalfUp"))), "-2.5")
    assert_eq(text_of(rescale(dec("-2.5"), 1, mode_named("HalfDown"))), "-2.5")
    assert_eq(text_of(rescale(dec("-2.5"), 1, mode_named("HalfEven"))), "-2.5")
    assert_eq(text_of(rescale(dec("-2.5"), 2, mode_named("Down"))), "-2.50")
    assert_eq(text_of(rescale(dec("-2.5"), 2, mode_named("Up"))), "-2.50")
    assert_eq(text_of(rescale(dec("-2.5"), 2, mode_named("Floor"))), "-2.50")
    assert_eq(text_of(rescale(dec("-2.5"), 2, mode_named("Ceiling"))), "-2.50")
    assert_eq(text_of(rescale(dec("-2.5"), 2, mode_named("HalfUp"))), "-2.50")
    assert_eq(text_of(rescale(dec("-2.5"), 2, mode_named("HalfDown"))), "-2.50")
    assert_eq(text_of(rescale(dec("-2.5"), 2, mode_named("HalfEven"))), "-2.50")
    assert_eq(text_of(rescale(dec("1.15"), 0, mode_named("Down"))), "1")
    assert_eq(text_of(rescale(dec("1.15"), 0, mode_named("Up"))), "2")
    assert_eq(text_of(rescale(dec("1.15"), 0, mode_named("Floor"))), "1")
    assert_eq(text_of(rescale(dec("1.15"), 0, mode_named("Ceiling"))), "2")
    assert_eq(text_of(rescale(dec("1.15"), 0, mode_named("HalfUp"))), "1")
    assert_eq(text_of(rescale(dec("1.15"), 0, mode_named("HalfDown"))), "1")
    assert_eq(text_of(rescale(dec("1.15"), 0, mode_named("HalfEven"))), "1")
    assert_eq(text_of(rescale(dec("1.15"), 1, mode_named("Down"))), "1.1")
    assert_eq(text_of(rescale(dec("1.15"), 1, mode_named("Up"))), "1.2")
    assert_eq(text_of(rescale(dec("1.15"), 1, mode_named("Floor"))), "1.1")
    assert_eq(text_of(rescale(dec("1.15"), 1, mode_named("Ceiling"))), "1.2")
    assert_eq(text_of(rescale(dec("1.15"), 1, mode_named("HalfUp"))), "1.2")
    assert_eq(text_of(rescale(dec("1.15"), 1, mode_named("HalfDown"))), "1.1")
    assert_eq(text_of(rescale(dec("1.15"), 1, mode_named("HalfEven"))), "1.2")
    assert_eq(text_of(rescale(dec("1.15"), 2, mode_named("Down"))), "1.15")
    assert_eq(text_of(rescale(dec("1.15"), 2, mode_named("Up"))), "1.15")
    assert_eq(text_of(rescale(dec("1.15"), 2, mode_named("Floor"))), "1.15")
    assert_eq(text_of(rescale(dec("1.15"), 2, mode_named("Ceiling"))), "1.15")
    assert_eq(text_of(rescale(dec("1.15"), 2, mode_named("HalfUp"))), "1.15")
    assert_eq(text_of(rescale(dec("1.15"), 2, mode_named("HalfDown"))), "1.15")
    assert_eq(text_of(rescale(dec("1.15"), 2, mode_named("HalfEven"))), "1.15")
    assert_eq(text_of(rescale(dec("-1.15"), 0, mode_named("Down"))), "-1")
    assert_eq(text_of(rescale(dec("-1.15"), 0, mode_named("Up"))), "-2")
    assert_eq(text_of(rescale(dec("-1.15"), 0, mode_named("Floor"))), "-2")
    assert_eq(text_of(rescale(dec("-1.15"), 0, mode_named("Ceiling"))), "-1")
    assert_eq(text_of(rescale(dec("-1.15"), 0, mode_named("HalfUp"))), "-1")
    assert_eq(text_of(rescale(dec("-1.15"), 0, mode_named("HalfDown"))), "-1")
    assert_eq(text_of(rescale(dec("-1.15"), 0, mode_named("HalfEven"))), "-1")
    assert_eq(text_of(rescale(dec("-1.15"), 1, mode_named("Down"))), "-1.1")
