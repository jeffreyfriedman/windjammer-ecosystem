use crate::is_pending
use crate::latest_version
use crate::migration_count
use crate::parse_filename
use crate::pending
use crate::pending_count
use crate::record_applied_sql
use crate::require_migrations
use crate::require_empty_migrations
use crate::require_pending
use crate::is_empty_migrations
use crate::schema_table_sql
use crate::select_applied_sql
use crate::sort_migrations
use crate::validate_unique_versions
use crate::version_applied
use crate::Migration
use std::strings

@test
fn test_parse_numeric_prefix() {
    match parse_filename("001_create_users.sql") {
        Ok(m) => {
            assert_eq(m.version, 1)
            assert_eq(m.name, "create_users")
            assert_eq(m.filename, "001_create_users.sql")
        },
        Err(_) => assert(false, "parse should succeed"),
    }
}

@test
fn test_parse_larger_version() {
    match parse_filename("042_add_indexes.sql") {
        Ok(m) => {
            assert_eq(m.version, 42)
            assert_eq(m.name, "add_indexes")
        },
        Err(_) => assert(false, "parse should succeed"),
    }
}

@test
fn test_parse_rejects_missing_extension() {
    match parse_filename("001_create_users") {
        Ok(_) => assert(false, "should reject"),
        Err(_) => assert(true, "ok"),
    }
}

@test
fn test_parse_rejects_non_numeric() {
    match parse_filename("create_users.sql") {
        Ok(_) => assert(false, "should reject"),
        Err(_) => assert(true, "ok"),
    }
}

@test
fn test_sort_by_version() {
    let mut items = Vec::new()
    match parse_filename("010_b.sql") {
        Ok(m) => items.push(m),
        Err(_) => assert(false, "parse"),
    }
    match parse_filename("002_a.sql") {
        Ok(m) => items.push(m),
        Err(_) => assert(false, "parse"),
    }
    match parse_filename("003_c.sql") {
        Ok(m) => items.push(m),
        Err(_) => assert(false, "parse"),
    }
    let sorted = sort_migrations(items)
    assert_eq(sorted.len(), 3)
    assert_eq(sorted[0].version, 2)
    assert_eq(sorted[1].version, 3)
    assert_eq(sorted[2].version, 10)
}

@test
fn test_pending_skips_applied() {
    let mut all = Vec::new()
    match parse_filename("001_a.sql") {
        Ok(m) => all.push(m),
        Err(_) => assert(false, "parse"),
    }
    match parse_filename("002_b.sql") {
        Ok(m) => all.push(m),
        Err(_) => assert(false, "parse"),
    }
    match parse_filename("003_c.sql") {
        Ok(m) => all.push(m),
        Err(_) => assert(false, "parse"),
    }
    let mut applied = Vec::new()
    applied.push(1)
    applied.push(2)
    let left = pending(all, applied)
    assert_eq(left.len(), 1)
    assert_eq(left[0].version, 3)
}

@test
fn test_pending_empty_when_all_applied() {
    let mut all = Vec::new()
    match parse_filename("001_a.sql") {
        Ok(m) => all.push(m),
        Err(_) => assert(false, "parse"),
    }
    let mut applied = Vec::new()
    applied.push(1)
    let left = pending(all, applied)
    assert_eq(left.len(), 0)
}

@test
fn test_validate_unique_versions_ok() {
    let mut all = Vec::new()
    match parse_filename("001_a.sql") {
        Ok(m) => all.push(m),
        Err(_) => assert(false, "parse"),
    }
    match parse_filename("002_b.sql") {
        Ok(m) => all.push(m),
        Err(_) => assert(false, "parse"),
    }
    match validate_unique_versions(all) {
        Ok(_) => assert(true, "ok"),
        Err(_) => assert(false, "should be unique"),
    }
}

@test
fn test_validate_unique_versions_dup() {
    let mut all = Vec::new()
    match parse_filename("001_a.sql") {
        Ok(m) => all.push(m),
        Err(_) => assert(false, "parse"),
    }
    match parse_filename("001_b.sql") {
        Ok(m) => all.push(m),
        Err(_) => assert(false, "parse"),
    }
    match validate_unique_versions(all) {
        Ok(_) => assert(false, "should fail"),
        Err(_) => assert(true, "duplicate detected"),
    }
}

@test
fn test_schema_table_sql() {
    let sql = schema_table_sql()
    assert_str_contains(sql, "schema_migrations")
    assert_str_contains(sql, "version")
}

@test
fn test_select_applied_sql() {
    let sql = select_applied_sql()
    assert_str_contains(sql, "schema_migrations")
    assert_str_contains(sql, "version")
}

@test
fn test_record_applied_sql() {
    match parse_filename("001_create_users.sql") {
        Ok(m) => {
            let sql = record_applied_sql(m, "2026-08-23T00:00:00Z")
            assert_str_contains(sql, "INSERT INTO schema_migrations")
            assert_str_contains(sql, "1")
            assert_str_contains(sql, "create_users")
            assert_str_contains(sql, "2026-08-23T00:00:00Z")
        },
        Err(_) => assert(false, "parse"),
    }
}

fn sample_migrations() -> Vec<Migration> {
    let mut all = Vec::new()
    match parse_filename("001_a.sql") {
        Ok(m) => all.push(m),
        Err(_) => {},
    }
    match parse_filename("002_b.sql") {
        Ok(m) => all.push(m),
        Err(_) => {},
    }
    match parse_filename("003_c.sql") {
        Ok(m) => all.push(m),
        Err(_) => {},
    }
    all
}

@test
fn test_pending_count_latest_and_is_pending() {
    assert_eq(migration_count(sample_migrations()), 3)
    assert_eq(latest_version(sample_migrations()), 3)
    let mut applied = Vec::new()
    applied.push(1)
    assert_eq(pending_count(sample_migrations(), applied), 2)
    let mut applied2 = Vec::new()
    applied2.push(1)
    assert(version_applied(applied2, 1), "1 applied")
    let mut applied3 = Vec::new()
    applied3.push(1)
    assert(is_pending(sample_migrations(), applied3, 2), "2 pending")
    let mut applied4 = Vec::new()
    applied4.push(1)
    assert(!is_pending(sample_migrations(), applied4, 1), "1 not pending")
    let mut applied5 = Vec::new()
    applied5.push(1)
    assert(!is_pending(sample_migrations(), applied5, 9), "missing version")
}

@test
fn test_empty_earliest_and_name_of_version() {
    use crate::earliest_version
    use crate::has_migrations
    use crate::is_empty_migrations
    use crate::name_of_version
    let empty: Vec<Migration> = Vec::new()
    assert(is_empty_migrations(empty), "empty")
    assert(!has_migrations(empty), "no migrations")
    assert(has_migrations(sample_migrations()), "has")
    assert(!is_empty_migrations(sample_migrations()), "not empty")
    assert_eq(earliest_version(sample_migrations()), 1)
    assert_eq(earliest_version(empty), 0)
    match name_of_version(sample_migrations(), 2) {
        Some(name) => assert_eq(name, "b"),
        None => assert(false, "name"),
    }
    match name_of_version(sample_migrations(), 9) {
        Some(_) => assert(false, "missing"),
        None => assert(true, "ok"),
    }
}

@test
fn test_require_name() {
    use crate::require_name
    match require_name(sample_migrations(), 2) {
        Ok(name) => assert_eq(name, "b"),
        Err(_) => assert(false, "name of 2"),
    }
    match require_name(sample_migrations(), 9) {
        Ok(_) => assert(false, "missing must Err"),
        Err(msg) => assert(strings.contains(msg, "9"), "mentions version"),
    }
}

@test
fn test_require_migrations() {
    match require_migrations(sample_migrations()) {
        Ok(n) => assert_eq(n, 3),
        Err(_) => assert(false, "sample set"),
    }
    match require_migrations(Vec::new()) {
        Ok(_) => assert(false, "empty must Err"),
        Err(msg) => assert(strings.contains(msg, "migrations"), "mentions migrations"),
    }
}

@test
fn test_require_empty_migrations() {
    match require_empty_migrations(Vec::new()) {
        Ok(n) => assert_eq(n, 0),
        Err(_) => assert(false, "empty set"),
    }
    match require_empty_migrations(sample_migrations()) {
        Ok(_) => assert(false, "sample must Err"),
        Err(msg) => assert(strings.contains(msg, "empty"), "mentions empty"),
    }
}

@test
fn test_require_pending() {
    let mut applied = Vec::new()
    applied.push(1)
    match require_pending(sample_migrations(), applied, 2) {
        Ok(version) => assert_eq(version, 2),
        Err(_) => assert(false, "2 pending"),
    }
    let mut done = Vec::new()
    done.push(1)
    match require_pending(sample_migrations(), done, 1) {
        Ok(_) => assert(false, "applied must Err"),
        Err(msg) => assert(strings.contains(msg, "pending"), "mentions pending"),
    }
}
