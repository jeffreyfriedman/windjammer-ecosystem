use crate::camel_case
use crate::constant_case
use crate::is_camel_case
use crate::is_constant_case
use crate::is_kebab_case
use crate::is_pascal_case
use crate::is_slug
use crate::is_snake_case
use crate::is_title_case
use crate::is_blank
use crate::kebab_case
use crate::pascal_case
