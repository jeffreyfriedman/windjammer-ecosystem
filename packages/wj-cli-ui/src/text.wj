use std::strings

/// Remove CSI escape sequences (`ESC [ ... final-byte`) such as colours and cursor moves.
pub fn strip_ansi(text: string) -> string {
    let mut out = ""
    let mut in_seq = false
    let mut seen_bracket = false
    for ch in strings.chars(text) {
        let code = ch as int
        if in_seq {
            if !seen_bracket {
                if ch == '[' {
                    seen_bracket = true
                } else {
                    in_seq = false
                }
            } else if code >= 64 && code <= 126 {
                in_seq = false
                seen_bracket = false
            }
        } else if code == 27 {
            in_seq = true
            seen_bracket = false
        } else {
            out += "${ch}"
        }
    }
    out
}

/// Terminal columns taken by one character: 0 for combining marks and zero-width, 2 for wide East Asian
/// characters and emoji, 1 otherwise.
pub fn char_width(code: int) -> int {
    if code == 0 || (code >= 0x0300 && code <= 0x036f) || (code >= 0x200b && code <= 0x200f) || code == 0xfeff || (code >= 0xfe00 && code <= 0xfe0f) {
        return 0
    }
    if code < 32 || (code >= 0x7f && code < 0xa0) {
        return 0
    }
    if (code >= 0x1100 && code <= 0x115f) || (code >= 0x2e80 && code <= 0xa4cf && code != 0x303f) || (code >= 0xac00 && code <= 0xd7a3) || (code >= 0xf900 && code <= 0xfaff) || (code >= 0xfe30 && code <= 0xfe6f) || (code >= 0xff00 && code <= 0xff60) || (code >= 0xffe0 && code <= 0xffe6) || (code >= 0x1f300 && code <= 0x1f64f) || (code >= 0x1f900 && code <= 0x1f9ff) || (code >= 0x20000 && code <= 0x3fffd) {
        return 2
    }
    1
}

/// Display width of text with ANSI sequences ignored.
pub fn display_width(text: string) -> int {
    let mut w = 0
    for ch in strings.chars(strip_ansi(text)) {
        w = w + char_width(ch as int)
    }
    w
}

fn spaces(n: int) -> string {
    let mut out = ""
    let mut i = 0
    while i < n {
        out += " "
        i = i + 1
    }
    out
}

pub fn pad_right(text: string, width: int) -> string {
    let w = display_width(text)
    if w >= width {
        return text
    }
    text + spaces(width - w)
}

pub fn pad_left(text: string, width: int) -> string {
    let w = display_width(text)
    if w >= width {
        return text
    }
    spaces(width - w) + text
}

pub fn center(text: string, width: int) -> string {
    let w = display_width(text)
    if w >= width {
        return text
    }
    let left = (width - w) / 2
    spaces(left) + text + spaces(width - w - left)
}

/// Cut plain text to at most `width` columns, ending in `…` when something was dropped.
pub fn truncate(text: string, width: int) -> string {
    if display_width(text) <= width {
        return text
    }
    if width <= 0 {
        return ""
    }
    let mut out = ""
    let mut used = 0
    for ch in strings.chars(text) {
        let cw = char_width(ch as int)
        if used + cw > width - 1 {
            break
        }
        out += "${ch}"
        used = used + cw
    }
    "${out}…"
}

/// Greedy word wrap to `width` columns; words longer than a line are kept whole.
pub fn wrap(text: string, width: int) -> Vec<string> {
    let mut lines: Vec<string> = Vec::new()
    let mut line = ""
    for word in strings.split_whitespace(text) {
        if strings.len(line) == 0 {
            line = word
        } else if display_width(line) + 1 + display_width(word) <= width {
            line += " ${word}"
        } else {
            lines.push(line)
            line = word
        }
    }
    if strings.len(line) > 0 {
        lines.push(line)
    }
    lines
}

/// `1536` -> `1.5 KiB` (binary units, one decimal from KiB up).
pub fn format_bytes(n: int) -> string {
    if n < 1024 {
        return "${n} B"
    }
    let units = ["KiB", "MiB", "GiB", "TiB"]
    let mut value = n as float / 1024.0
    let mut i = 0
    while value >= 1024.0 && i < 3 {
        value = value / 1024.0
        i = i + 1
    }
    "${value:.1} ${units[i]}"
}

/// `3725000` ms -> `1h 2m 5s`; sub-second values print as milliseconds.
pub fn format_duration_ms(ms: int) -> string {
    if ms < 1000 {
        return "${ms}ms"
    }
    let total = ms / 1000
    let h = total / 3600
    let m = (total % 3600) / 60
    let s = total % 60
    if h > 0 {
        return "${h}h ${m}m ${s}s"
    }
    if m > 0 {
        return "${m}m ${s}s"
    }
    "${s}s"
}
