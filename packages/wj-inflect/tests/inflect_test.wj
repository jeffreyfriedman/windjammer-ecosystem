@test
fn test_require_pascal() {
    match require_pascal("HelloWorld") {
        Ok(s) => assert_eq(s, "HelloWorld"),
        Err(_) => assert(false, "pascal"),
    }
    match require_pascal("helloWorld") {
        Ok(_) => assert(false, "camel must Err"),
        Err(msg) => assert(strings.contains(msg, "pascal"), "mentions pascal"),
    }
}

@test
fn test_require_constant() {
    match require_constant("HELLO_WORLD") {
        Ok(s) => assert_eq(s, "HELLO_WORLD"),
        Err(_) => assert(false, "constant"),
    }
    match require_constant("helloWorld") {
        Ok(_) => assert(false, "camel must Err"),
        Err(msg) => assert(strings.contains(msg, "constant"), "mentions constant"),
    }
}

@test
fn test_require_title() {
    match require_title("Hello World") {
        Ok(s) => assert(is_title_case(s), "title"),
        Err(_) => assert(false, "title ok"),
    }
    match require_title("hello world") {
        Ok(_) => assert(false, "lower must Err"),
        Err(msg) => assert(strings.contains(msg, "title"), "mentions title"),
    }
}

@test
fn test_require_blank() {
    match require_blank("   ") {
        Ok(s) => assert(is_blank(s), "blank"),
        Err(_) => assert(false, "blank ok"),
    }
    match require_blank("a") {
        Ok(_) => assert(false, "letter must Err"),
        Err(msg) => assert(strings.contains(msg, "blank"), "mentions blank"),
    }
}
