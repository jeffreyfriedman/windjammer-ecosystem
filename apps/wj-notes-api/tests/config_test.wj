use crate::domain::NotesConfig

fn test_config_defaults() {
    let cfg = NotesConfig::defaults()
    assert_eq(cfg.allowed_origins.len(), 1)
    assert_eq(cfg.allowed_origins[0], "*")
    assert_eq(cfg.rate_limit, 100)
    assert_eq(cfg.window_ms, 60_000)
    assert_eq(cfg.max_title_len, 200)
    assert_eq(cfg.max_body_len, 10_000)
}
