use std::encoding
use std::strings

/// Base64-encode UTF-8 text.
pub fn encode(text: string) -> string {
    encoding.base64_encode_string(text)
}

/// Alias of `encode` — prefer this name at app call sites (cargo-bin may
/// over-borrow a bare `encode` into an owned formal).
pub fn encode_text(text: string) -> string {
    encode(text)
}

/// Decode a base64 string to UTF-8 text.
pub fn decode(text: string) -> Result<string, string> {
    encoding.base64_decode_string(text)
}

/// Alias of `decode` for symmetry with `encode_text`.
pub fn decode_text(text: string) -> Result<string, string> {
    decode(text)
}

/// Base64-encode raw bytes.
pub fn encode_bytes(data: Vec<u8>) -> string {
    encoding.base64_encode(data)
}

/// Decode a base64 string to raw bytes.
pub fn decode_bytes(text: string) -> Result<Vec<u8>, string> {
    encoding.base64_decode(text)
}

/// HTTP `Authorization: Basic …` header for `user` / `pass`.
pub fn basic_auth_header(user: string, pass: string) -> string {
    let token = encode("${user}:${pass}")
    "Authorization: Basic ${token}"
}

/// True when `header` is an `Authorization: Basic …` line.
pub fn is_basic_auth_header(header: string) -> bool {
    strings.starts_with(strings.trim(header), "Authorization: Basic ")
}
