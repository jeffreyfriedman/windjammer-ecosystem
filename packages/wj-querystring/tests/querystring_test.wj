use crate::append
use crate::get
use crate::get_all
use crate::get_or
use crate::has
use crate::is_empty
use crate::keys
use crate::pair_count
use crate::parse
use crate::remove
use crate::require
use crate::set
use crate::stringify
use crate::unique_key_count
use crate::value_count
use std::strings

@test
fn test_parse_empty() {
    let pairs = parse("")
    assert_eq(pairs.len(), 0)
}

@test
fn test_parse_simple_pairs() {
    let pairs = parse("a=1&b=two")
    assert_eq(pairs.len(), 2)
    assert_eq(pairs[0].0, "a")
    assert_eq(pairs[0].1, "1")
    assert_eq(pairs[1].0, "b")
    assert_eq(pairs[1].1, "two")
}

@test
fn test_parse_key_without_value() {
    let pairs = parse("flag&x=1")
    assert_eq(pairs.len(), 2)
    assert_eq(pairs[0].0, "flag")
    assert_eq(pairs[0].1, "")
    assert_eq(pairs[1].0, "x")
    assert_eq(pairs[1].1, "1")
}

@test
fn test_parse_strips_leading_question() {
    let pairs = parse("?a=1")
    assert_eq(pairs.len(), 1)
    assert_eq(pairs[0].0, "a")
    assert_eq(pairs[0].1, "1")
}

@test
fn test_stringify_roundtrip() {
    let pairs = parse("a=1&b=2")
    let text = stringify(pairs)
    assert_eq(text, "a=1&b=2")
}

@test
fn test_get_first_value() {
    match get("a=1&a=2&b=3", "a") {
        Some(v) => assert_eq(v, "1"),
        None => assert(false, "expected a"),
    }
}

@test
fn test_get_all_repeated_keys() {
    let values = get_all("tag=red&tag=blue&x=1", "tag")
    assert_eq(values.len(), 2)
    assert_eq(values[0], "red")
    assert_eq(values[1], "blue")
}

@test
fn test_has_true_false() {
    assert(has("a=1&b=2", "b"), "b present")
    assert(!has("a=1", "z"), "z missing")
}

@test
fn test_remove_drops_all_matching_keys() {
    let out = remove("a=1&b=2&a=3", "a")
    assert_eq(out, "b=2")
}

@test
fn test_append_keeps_existing() {
    let out = append("a=1", "a", "2")
    assert(strings.contains(out, "a=1"), "keeps first")
    assert(strings.contains(out, "a=2"), "appends second")
}

@test
fn test_parse_plus_as_space() {
    let pairs = parse("q=hello+world")
    assert_eq(pairs.len(), 1)
    assert_eq(pairs[0].1, "hello world")
}

@test
fn test_stringify_encodes_spaces() {
    let pairs = parse("q=hello world")
    let text = stringify(pairs)
    assert(strings.contains(text, "q="), "has key")
    assert(!strings.contains(text, " "), "no raw space")
}

@test
fn test_parse_percent_encoded_value() {
    let pairs = parse("q=hello%20world")
    assert_eq(pairs.len(), 1)
    assert_eq(pairs[0].1, "hello world")
}

@test
fn test_stringify_encodes_ampersand_in_value() {
    let text = append("", "q", "a&b")
    assert(strings.contains(text, "q="), "has key")
    assert(!strings.contains(text, "q=a&b"), "ampersand must be encoded")
    match get(text, "q") {
        Some(v) => assert_eq(v, "a&b"),
        None => assert(false, "roundtrip q"),
    }
}

@test
fn test_set_replaces_existing_key() {
    let text = set("a=1&b=2&a=3", "a", "9")
    match get(text, "a") {
        Some(v) => assert_eq(v, "9"),
        None => assert(false, "set a"),
    }
    assert_eq(get_all(text, "a").len(), 1)
    match get(text, "b") {
        Some(v) => assert_eq(v, "2"),
        None => assert(false, "keep b"),
    }
}

@test
fn test_get_or_default() {
    assert_eq(get_or("a=1", "a", "0"), "1")
    assert_eq(get_or("a=1", "b", "0"), "0")
}

@test
fn test_is_empty_and_pair_count() {
    assert(is_empty(""), "empty string")
    assert(is_empty("?"), "leading question only")
    assert(!is_empty("a=1"), "has pair")
    assert_eq(pair_count(""), 0)
    assert_eq(pair_count("a=1&b=2&a=3"), 3)
}

@test
fn test_keys_unique_in_order() {
    let ks = keys("a=1&b=2&a=3")
    assert_eq(ks.len(), 2)
    assert_eq(ks[0], "a")
    assert_eq(ks[1], "b")
}

@test
fn test_unique_key_count_and_value_count() {
    assert_eq(unique_key_count("a=1&b=2&a=3"), 2)
    assert_eq(unique_key_count(""), 0)
    assert_eq(value_count("a=1&b=2&a=3", "a"), 2)
    assert_eq(value_count("a=1&b=2&a=3", "b"), 1)
    assert_eq(value_count("a=1&b=2&a=3", "z"), 0)
}

@test
fn test_require() {
    match require("a=1&b=2", "a") {
        Ok(v) => assert_eq(v, "1"),
        Err(_) => assert(false, "require a"),
    }
    match require("a=1&b=2", "z") {
        Ok(_) => assert(false, "missing must Err"),
        Err(msg) => assert(strings.contains(msg, "z"), "mentions key"),
    }
}
