// End-to-end check over a real socket. It is a program, not an @test, because `wj test` has no network grant.
// Run from the package folder:
//   wj run --interpret --allow-network --allow process --allow fs.read --allow console examples/e2e.wj
// It starts examples/serve.wj as a child process on a free loopback port, fetches files from the fixture tree,
// compares status, headers and body, stops the child, and prints `e2e: ok` (exit 0) when every row matches.
use std::crypto
use std::encoding
use std::fs
use std::http
use std::subprocess
use std::time

const CSP: string = "default-src 'self'; img-src 'self' data:; media-src 'self'; object-src 'none'"

// method, path, status, content-type, fixture file whose bytes are the body ("" for none)
fn rows() -> Vec<Vec<string>> {
    [
        ["GET", "/", "200", "text/html; charset=utf-8", "tests/fixtures/tree/site/index.html"],
        ["GET", "/app.js", "200", "text/javascript; charset=utf-8", "tests/fixtures/tree/site/app.js"],
        ["GET", "/style.css", "200", "text/css; charset=utf-8", "tests/fixtures/tree/site/style.css"],
        ["GET", "/assets/pixel.png", "200", "image/png", "tests/fixtures/tree/site/assets/pixel.png"],
        ["GET", "/assets/blob.bin", "200", "application/octet-stream", "tests/fixtures/tree/site/assets/blob.bin"],
        ["GET", "/data/items.json", "200", "application/json; charset=utf-8", "tests/fixtures/tree/data/items.json"],
        ["HEAD", "/app.js", "200", "text/javascript; charset=utf-8", ""],
        ["GET", "/data/", "404", "text/plain; charset=utf-8", ""],
        ["GET", "/%2e%2e/secret.txt", "404", "text/plain; charset=utf-8", ""],
        ["GET", "/link.txt", "404", "text/plain; charset=utf-8", ""],
        ["POST", "/app.js", "405", "text/plain; charset=utf-8", ""],
    ]
}

// A port nobody listens on: the first candidate whose connection is refused.
fn free_port() -> int {
    let mut port = 18900
    while port < 19000 {
        match http::get("http://127.0.0.1:${port}/") {
            Ok(_) => {},
            Err(_) => return port,
        }
        port += 1
    }
    0
}

// The interpreter takes several seconds to start the server; poll for up to 20 s.
fn wait_until_up(base: string) -> bool {
    let mut tries = 0
    while tries < 80 {
        match http::get("${base}/") {
            Ok(_) => return true,
            Err(_) => time::sleep_millis(250),
        }
        tries += 1
    }
    false
}

fn check_row(base: string, row: Vec<string>) -> Vec<string> {
    let mut problems: Vec<string> = Vec::new()
    let label = "${row[0]} ${row[1]}"
    let r = match http::request(row[0], "${base}${row[1]}").timeout_secs(30).send() {
        Ok(r) => r,
        Err(e) => return ["${label}: transport error ${e}"],
    }
    let h = r.headers()
    if "${r.status_code()}" != row[2] {
        problems.push("${label}: status ${r.status_code()} want ${row[2]}")
    }
    if (h.get("content-type") ?? "") != row[3] {
        problems.push("${label}: content-type ${h.get("content-type") ?? ""} want ${row[3]}")
    }
    if row[2] == "200" {
        if (h.get("content-security-policy") ?? "") != CSP {
            problems.push("${label}: content-security-policy differs")
        }
        if (h.get("cache-control") ?? "") != "no-store" {
            problems.push("${label}: cache-control differs")
        }
        if (h.get("x-content-type-options") ?? "") != "nosniff" {
            problems.push("${label}: nosniff missing")
        }
    }
    if row[2] == "405" && (h.get("allow") ?? "") != "GET, HEAD" {
        problems.push("${label}: allow is ${h.get("allow") ?? ""}")
    }
    if row[0] == "GET" && row[2] == "200" {
        let want = fs::read(row[4]) ?? []
        let got = r.bytes().unwrap_or([])
        if encoding::hex_encode(crypto::sha256_bytes(got)) != encoding::hex_encode(crypto::sha256_bytes(want)) {
            problems.push("${label}: body differs from ${row[4]}")
        }
    }
    problems
}

fn main() {
    let port = free_port()
    assert(port > 0, "a free port")
    let base = "http://127.0.0.1:${port}"
    let args = ["run", "--interpret", "--allow-network", "--allow", "fs.read", "--allow", "console", "examples/serve.wj", "--port", "${port}",
        "--site", "tests/fixtures/tree/site", "--data", "tests/fixtures/tree/data"]
    let child = match subprocess::spawn("wj", args) {
        Ok(c) => c,
        Err(e) => {
            assert(false, "spawn: ${e}")
            return
        },
    }
    let up = wait_until_up(base)
    let mut problems: Vec<string> = Vec::new()
    if up {
        for row in rows() {
            for p in check_row(base, row) {
                problems.push(p)
            }
        }
    }
    let _ = subprocess::kill(child)
    let _ = subprocess::wait(child)
    assert(up, "server never answered")
    assert_eq(problems.join("\n"), "")
    match http::get("${base}/") {
        Ok(_) => assert(false, "server still answering after kill"),
        Err(_) => {},
    }
    println("e2e: ok (${rows().len()} rows on port ${port})")
}
