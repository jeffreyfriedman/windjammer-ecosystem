use std::collections::HashMap
use std::strings

/// Replace `{{key}}` placeholders using `vars`. Unknown keys stay in the output.
pub fn render(template: string, vars: HashMap<string, string>) -> string {
    let mut out = template
    for (key, value) in vars {
        let token = "{{${key}}}"
        out = strings.replace(out, token, value)
    }
    out
}

/// Like `render`, but returns `Err` when the template references a key not in `vars`.
pub fn render_strict(template: string, vars: HashMap<string, string>) -> Result<string, string> {
    let required = placeholder_names(template)
    let mut out = template
    let mut provided = Vec::new()
    for (key, value) in vars {
        let token = "{{${key}}}"
        out = strings.replace(out, token, value)
        provided.push(key)
    }
    let mut i = 0
    while i < required.len() {
        let name = required[i]
        if !list_contains(provided, name) {
            return Err("missing template key: ${name}")
        }
        i = i + 1
    }
    Ok(out)
}

/// Keys referenced as `{{key}}` in `template` that are absent from `vars`.
pub fn missing_keys(template: string, vars: HashMap<string, string>) -> Vec<string> {
    let required = placeholder_names(template)
    let mut provided = Vec::new()
    for (key, _value) in vars {
        provided.push(key)
    }
    let mut missing = Vec::new()
    for name in required {
        if !list_contains(provided, name) && !list_contains(missing, name) {
            missing.push(name)
        }
    }
    missing
}

/// Every `{{key}}` name appearing in `template` (in order, duplicates allowed).
pub fn placeholder_names(template: string) -> Vec<string> {
    let mut names = Vec::new()
    let mut i = 0
    while i < strings.len(template) {
        if strings.starts_with(strings.substring(template, i, strings.len(template)), "{{") {
            match read_placeholder(template, i) {
                Some(pair) => {
                    names.push(pair.0)
                    i = pair.1
                },
                None => {
                    i = i + 1
                },
            }
        } else {
            i = i + 1
        }
    }
    names
}

fn list_contains(items: Vec<string>, needle: string) -> bool {
    let mut i = 0
    while i < items.len() {
        if items[i] == needle {
            return true
        }
        i = i + 1
    }
    false
}

/// Returns `(name, index_after_closing)`.
fn read_placeholder(text: string, start: usize) -> Option<(string, usize)> {
    if !strings.starts_with(strings.substring(text, start, strings.len(text)), "{{") {
        return None
    }
    let mut i = start + 2
    let mut name = ""
    while i + 1 < strings.len(text) {
        let tail = strings.substring(text, i, strings.len(text))
        if strings.starts_with(tail, "}}") {
            if name.len() == 0 {
                return None
            }
            return Some((name, i + 2))
        }
        let ch = strings.substring_chars(text, i, i + 1)
        name = "${name}${ch}"
        i = i + 1
    }
    None
}
