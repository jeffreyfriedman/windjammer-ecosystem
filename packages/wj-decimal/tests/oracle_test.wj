@test
fn test_add_sub_mul_match_python() {
    assert_eq(text_of(add(dec("1.10"), dec("2.205"))), "3.305")
    assert_eq(text_of(sub(dec("1.10"), dec("2.205"))), "-1.105")
    assert_eq(text_of(mul(dec("1.10"), dec("2.205"))), "2.42550")
    assert_eq(text_of(add(dec("-0.5"), dec("0.25"))), "-0.25")
    assert_eq(text_of(sub(dec("-0.5"), dec("0.25"))), "-0.75")
    assert_eq(text_of(mul(dec("-0.5"), dec("0.25"))), "-0.125")
    assert_eq(text_of(add(dec("100"), dec("0.01"))), "100.01")
    assert_eq(text_of(sub(dec("100"), dec("0.01"))), "99.99")
    assert_eq(text_of(mul(dec("100"), dec("0.01"))), "1.00")
    assert_eq(text_of(add(dec("12345.678"), dec("-0.002"))), "12345.676")
    assert_eq(text_of(sub(dec("12345.678"), dec("-0.002"))), "12345.680")
    assert_eq(text_of(mul(dec("12345.678"), dec("-0.002"))), "-24.691356")
    assert_eq(text_of(add(dec("0.1"), dec("0.2"))), "0.3")
    assert_eq(text_of(sub(dec("0.1"), dec("0.2"))), "-0.1")
    assert_eq(text_of(mul(dec("0.1"), dec("0.2"))), "0.02")
    assert_eq(text_of(add(dec("999999999.99"), dec("0.01"))), "1000000000.00")
    assert_eq(text_of(sub(dec("999999999.99"), dec("0.01"))), "999999999.98")
    assert_eq(text_of(mul(dec("999999999.99"), dec("0.01"))), "9999999.9999")
}
