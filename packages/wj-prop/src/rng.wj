/// PCG32 (O'Neill 2014, XSH-RR 64/32): a small, fast generator with a 2^64 period per stream.
pub struct Rng {
    state: u64,
    inc: u64,
}

fn step(r: Rng) -> u32 {
    let old = r.state
    r.state = old.wrapping_mul(6364136223846793005).wrapping_add(r.inc)
    let xorshifted = (((old >> 18) ^ old) >> 27) as u32
    let rot = (old >> 59) as u32
    (xorshifted >> rot) | (xorshifted << ((32 - rot) & 31))
}

/// Seed a generator: `seed` picks the starting point, `stream` the sequence (same as `pcg32_srandom_r`).
pub fn new_rng(seed: int, stream: int) -> Rng {
    let mut r = Rng { state: 0, inc: (((stream as u64) << 1) | 1) }
    let _ = step(r)
    r.state = r.state.wrapping_add(seed as u64)
    let _ = step(r)
    r
}

impl Rng {
    /// The next 32 random bits, as a non-negative `int`.
    pub fn next_u32(self) -> int {
        step(self) as int
    }

    /// Uniform in `0..bound` without modulo bias (rejection sampling, as in `pcg32_boundedrand_r`).
    pub fn below(self, bound: int) -> int {
        if bound <= 1 {
            return 0
        }
        let threshold = (4294967296 - bound) % bound
        let mut r = step(self) as int
        while r < threshold {
            r = step(self) as int
        }
        r % bound
    }

    /// Uniform in `lo..=hi`.
    pub fn range(self, lo: int, hi: int) -> int {
        if hi <= lo {
            return lo
        }
        lo + self.below(hi - lo + 1)
    }

    pub fn coin(self) -> bool {
        self.below(2) == 1
    }

    /// Uniform in `[0, 1)` with 32 bits of resolution.
    pub fn unit(self) -> float {
        step(self) as float / 4294967296.0
    }
}
