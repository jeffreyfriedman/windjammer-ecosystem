use crate::Receiver
use crate::counter_get
use crate::counter_inc
use crate::counter_new
use crate::recv_int
use crate::send_int
use crate::unbounded_int

/// Send `0..n` then sentinel `-1` on an unbounded int channel (same-thread).
/// Returns the receiver for draining.
pub fn send_int_range_with_sentinel(n: int) -> Receiver<int> {
    let pair = unbounded_int()
    let mut tx = pair.0
    let mut i: int = 0
    while i < n {
        tx = send_int(tx, i)
        i = i + 1
    }
    send_int(tx, -1)
    pair.1
}

/// Drain until sentinel `< 0`. Returns (count, sum) using SharedInt counter.
pub fn drain_int_until_sentinel(mut rx: Receiver<int>) -> (int, int) {
    let mut count = counter_new(0)
    let mut sum: int = 0
    while true {
        let got = recv_int(rx)
        rx = got.0
        let v = got.1
        if v < 0 {
            break
        }
        sum = sum + v
        count = counter_inc(count)
    }
    (counter_get(count), sum)
}

/// Fan-out `0..n` through a channel and sum values (dogfood for Shared + Channel).
pub fn channel_sum_range(n: int) -> (int, int) {
    let rx = send_int_range_with_sentinel(n)
    drain_int_until_sentinel(rx)
}
