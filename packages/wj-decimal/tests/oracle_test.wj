    assert_eq(text_of(div(dec("1"), dec("-3"), 2, mode_named("HalfEven"))), "-0.33")
    assert_eq(text_of(div(dec("1"), dec("-3"), 4, mode_named("Down"))), "-0.3333")
    assert_eq(text_of(div(dec("1"), dec("-3"), 4, mode_named("Up"))), "-0.3334")
    assert_eq(text_of(div(dec("1"), dec("-3"), 4, mode_named("Floor"))), "-0.3334")
