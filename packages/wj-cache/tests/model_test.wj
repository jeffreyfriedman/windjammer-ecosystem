// The expected result of every operation comes from a Python OrderedDict model of LRU + TTL (same rules as the docs).
use crate::lru::new_cache
use std::strings

fn run_script(script: Vec<string>) -> string {
    let mut c = new_cache(4, 50)
    let mut bad = ""
    let mut n = 0
    for line in script {
        n = n + 1
        let f = strings.split(line, "|")
        let op = f[0]
        let key = f[1]
        let ttl = f[3].parse::<int>().unwrap_or(0)
        let now = f[4].parse::<int>().unwrap_or(0)
        let want = f[5]
        let mut got = ""
        if op == "put" {
            c.put_ttl(key, f[2], ttl, now)
            got = ""
        } else if op == "get" {
            got = c.get(key, now).unwrap_or("-")
        } else if op == "peek" {
            got = c.peek(key, now).unwrap_or("-")
        } else if op == "del" {
            got = if c.delete(key) { "1" } else { "0" }
        } else {
            got = "${c.purge_expired(now)}"
        }
        if got != want {
            bad = bad + "op ${n} (${line}): got ${got}\n"
        }
    }
    let st = c.stats()
    bad + "stats:${st.hits},${st.misses},${st.evictions},${st.expirations} final:" + c.keys_lru().join(",")
}

