    assert_eq(text_of(rescale(dec("-0.125"), 2, mode_named("Up"))), "-0.13")
    assert_eq(text_of(rescale(dec("-0.125"), 2, mode_named("Floor"))), "-0.13")
    assert_eq(text_of(rescale(dec("-0.125"), 2, mode_named("Ceiling"))), "-0.12")
    assert_eq(text_of(rescale(dec("-0.125"), 2, mode_named("HalfUp"))), "-0.13")
    assert_eq(text_of(rescale(dec("-0.125"), 2, mode_named("HalfDown"))), "-0.12")
    assert_eq(text_of(rescale(dec("-0.125"), 2, mode_named("HalfEven"))), "-0.12")
    assert_eq(text_of(rescale(dec("2.4999"), 0, mode_named("Down"))), "2")
    assert_eq(text_of(rescale(dec("2.4999"), 0, mode_named("Up"))), "3")
    assert_eq(text_of(rescale(dec("2.4999"), 0, mode_named("Floor"))), "2")
