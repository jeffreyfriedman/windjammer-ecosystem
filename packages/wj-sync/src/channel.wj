// Message-passing channels (CSP). Ownership moves with messages.

use std::sync::mpsc

/// Sender half of an unbounded int channel.
pub struct IntSender {
    tx: mpsc::Sender<int>,
}

/// Receiver half of an unbounded int channel.
pub struct IntReceiver {
    rx: mpsc::Receiver<int>,
}

/// Sender half of a bounded int channel (`sync_channel`).
pub struct BoundedIntSender {
    tx: mpsc::SyncSender<int>,
}

/// Create an unbounded int channel.
pub fn unbounded_int() -> (IntSender, IntReceiver) {
    let pair = mpsc::channel()
    (
        IntSender { tx: pair.0 },
        IntReceiver { rx: pair.1 },
    )
}

/// Create a bounded int channel with capacity `cap` (blocks send when full).
pub fn bounded_int(cap: int) -> (BoundedIntSender, IntReceiver) {
    let pair = mpsc::sync_channel(cap)
    (
        BoundedIntSender { tx: pair.0 },
        IntReceiver { rx: pair.1 },
    )
}

/// Send on a bounded sender; ownership returns for reuse.
pub fn send_bounded(tx: BoundedIntSender, value: int) -> BoundedIntSender {
    match tx.tx.send(value) {
        Ok(_) => tx,
        Err(_) => tx,
    }
}


/// Send an int; ownership moves to the channel.
pub fn send_int(tx: IntSender, value: int) -> IntSender {
    match tx.tx.send(value) {
        Ok(_) => tx,
        Err(_) => tx,
    }
}

/// Blocking receive; returns (receiver, value) so the channel can be reused.
pub fn recv_int(rx: IntReceiver) -> (IntReceiver, int) {
    let out = match rx.rx.recv() {
        Ok(v) => v,
        Err(_) => 0,
    }
    (rx, out)
}

/// Non-blocking receive: `(receiver, present, value)`.
pub fn try_recv_int(rx: IntReceiver) -> (IntReceiver, bool, int) {
    let result = match rx.rx.try_recv() {
        Ok(v) => (true, v),
        Err(_) => (false, 0),
    }
    (rx, result.0, result.1)
}

/// Clone an unbounded sender (fan-out producers). Returns (original, clone).
pub fn clone_sender(tx: IntSender) -> (IntSender, IntSender) {
    let cloned = IntSender {
        tx: tx.tx.clone(),
    }
    (tx, cloned)
}
