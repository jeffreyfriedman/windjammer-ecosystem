use crate::domain::ProxyConfig
use crate::domain::has_strip_prefix
use crate::domain::is_unlimited_log

fn test_config_defaults() {
    let cfg = ProxyConfig::defaults()
    assert_eq(cfg.upstream, "http://127.0.0.1:9000")
    assert_eq(cfg.strip_prefix, "")
    assert_eq(cfg.rate_limit, 100)
    assert_eq(cfg.window_ms, 60_000)
    assert_eq(cfg.log_max, 1000)
}

fn test_strip_and_log_predicates() {
    assert(!has_strip_prefix(ProxyConfig::defaults()), "no strip")
    assert(!is_unlimited_log(ProxyConfig::defaults()), "capped")
    let mut cfg = ProxyConfig::defaults()
    cfg.strip_prefix = "/api"
    cfg.log_max = 0
    assert(has_strip_prefix(cfg), "has strip")
    let mut unlimited = ProxyConfig::defaults()
    unlimited.log_max = 0
    assert(is_unlimited_log(unlimited), "unlimited")
}
