use crate::HttpResult
use crate::body_len
use crate::is_empty_body
use crate::status_is_client_error
use crate::status_is_created
use crate::status_is_informational
use crate::status_is_no_content
use crate::status_is_ok
use crate::status_is_redirect
use crate::status_is_server_error
use crate::status_is_success
use crate::require_ok
use crate::error_message
use crate::from_parts

fn test_status_is_success_accepts_2xx() {
    assert(status_is_success(200), "200")
    assert(status_is_success(201), "201")
    assert(status_is_success(204), "204")
    assert(!status_is_success(199), "199")
    assert(!status_is_success(300), "300")
    assert(!status_is_success(404), "404")
    assert(!status_is_success(500), "500")
}

fn test_status_is_client_and_server_error() {
    assert(status_is_client_error(400), "400")
    assert(status_is_client_error(404), "404")
    assert(!status_is_client_error(500), "500 not client")
    assert(status_is_server_error(500), "500")
    assert(status_is_server_error(503), "503")
    assert(!status_is_server_error(404), "404 not server")
}

fn test_require_ok_returns_body_on_success() {
    let result = from_parts(200, "{\"ok\":true}")
    match require_ok(result) {
        Ok(body) => assert_str_contains(body, "ok"),
        Err(_) => assert(false, "expected Ok"),
    }
}

fn test_require_ok_errors_on_4xx() {
    let result = from_parts(404, "missing")
    match require_ok(result) {
        Ok(_) => assert(false, "expected Err"),
        Err(msg) => {
            assert_str_contains(msg, "404")
            assert_str_contains(msg, "missing")
        },
    }
}

fn test_error_message_includes_status_and_body() {
    let msg = error_message(500, "boom")
    assert_str_contains(msg, "500")
    assert_str_contains(msg, "boom")
}

fn test_from_parts_builds_result() {
    let result = from_parts(201, "created")
    assert_eq(result.status, 201)
    assert_eq(result.body, "created")
}

fn test_http_result_is_success_method() {
    let ok = from_parts(204, "")
    assert(ok.is_success(), "204 should succeed")
    let bad = from_parts(401, "nope")
    assert(!bad.is_success(), "401 should fail")
}

fn test_status_is_ok_redirect_informational() {
    assert(status_is_ok(200), "200")
    assert(!status_is_ok(201), "201 not ok")
    assert(status_is_redirect(301), "301")
    assert(status_is_redirect(302), "302")
    assert(!status_is_redirect(200), "200 not redirect")
    assert(status_is_informational(100), "100")
    assert(!status_is_informational(200), "200 not 1xx")
}

fn test_created_no_content_and_body_helpers() {
    assert(status_is_created(201), "201")
    assert(!status_is_created(200), "200 not created")
    assert(status_is_no_content(204), "204")
    assert(!status_is_no_content(200), "200 not no-content")
    let filled = from_parts(200, "hello")
    assert_eq(body_len(filled), 5)
    assert(!is_empty_body(filled), "has body")
    let empty = from_parts(204, "")
    assert_eq(body_len(empty), 0)
    assert(is_empty_body(empty), "empty body")
}
