pub struct SchedulerConfig {
    pub default_max_minutes: int,
}

impl SchedulerConfig {
    pub fn defaults() -> SchedulerConfig {
        SchedulerConfig {
            default_max_minutes: 1440,
        }
    }
}

pub fn config_from_env() -> SchedulerConfig {
    SchedulerConfig::defaults()
}

pub fn max_minutes_of(cfg: SchedulerConfig) -> int {
    cfg.default_max_minutes
}

/// Default minute budget when it is a full day.
pub fn require_day_budget(cfg: SchedulerConfig) -> Result<int, string> {
    if is_day_budget(cfg) {
        Ok(max_minutes_of(cfg))
    } else {
        Err("expected day budget")
    }
}

/// True when the default budget is a full day (1440 minutes).
pub fn is_day_budget(cfg: SchedulerConfig) -> bool {
    cfg.default_max_minutes == 1440
}
