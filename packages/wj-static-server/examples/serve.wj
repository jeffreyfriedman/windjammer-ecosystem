// Serves two folders on 127.0.0.1: the first at /, the second at /data.
// Run: wj run --interpret --allow-network --allow fs.read --allow console examples/serve.wj --port 8080 --site tests/fixtures/tree/site --data tests/fixtures/tree/data
use std::cli
use crate::static_server::{StaticServer, mount, serve}

fn main() {
    let m = cli::app("serve", "0.1.0", "Static file server, 127.0.0.1 only")
        .arg("port", None, Some("port"), "TCP port (default 8080)", false)
        .arg("site", None, Some("site"), "folder served at /", false)
        .arg("data", None, Some("data"), "folder served at /data", false)
        .parse()
    let port = (m.get("port") ?? "8080").parse::<int>().unwrap_or(8080)
    let site = m.get("site") ?? "tests/fixtures/tree/site"
    let data = m.get("data") ?? "tests/fixtures/tree/data"
    let server = match StaticServer::new([mount("/", site), mount("/data", data)]) {
        Ok(s) => s,
        Err(e) => {
            eprintln("serve: ${e}")
            std::process::exit(1)
        },
    }
    println("serving http://127.0.0.1:${port}/")
    match serve(server, port) {
        Ok(_) => {},
        Err(e) => {
            eprintln("serve: ${e}")
            std::process::exit(1)
        },
    }
}
