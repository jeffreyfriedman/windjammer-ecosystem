use crate::Decimal
use crate::Rounding
use crate::abs
use crate::add
use crate::allocate
use crate::compare
use crate::div
use crate::equals
use crate::format_places
use crate::from_int
use crate::mul
use crate::neg
use crate::new
use crate::parse
use crate::rescale
use crate::signum
use crate::sub
use crate::to_string
use crate::with_thousands

fn show(r: Result<Decimal, string>) -> string {
    match r {
        Ok(d) => to_string(d),
        Err(e) => "error: ${e}",
    }
}

fn placed(d: Decimal, places: int, mode: Rounding) -> string {
    match format_places(d, places, mode) {
        Ok(t) => t,
        Err(e) => "error: ${e}",
    }
}

fn printed(text: string) -> string {
    if text == "+3.1400" {
        return "3.1400"
    }
    if text == "000.5" {
        return "0.5"
    }
    text
}

@test
fn test_parse_and_print_round_trip() {
    let cases: Vec<string> = ["0", "1", "-1", "12.50", "-0.005", "+3.1400", "000.5", "123456789.123456789"]
    for text in cases {
        let d = match parse(text) {
            Ok(v) => v,
            Err(e) => new(0, 0),
        }
        // Printing keeps the scale and drops a leading plus and redundant leading zeros.
        assert_eq(to_string(d), printed(text))
    }
}

@test
fn test_parse_rejects_bad_input() {
    let bad: Vec<string> = ["", "  ", "abc", "1.2.3", "--1", "1e5", ".", "-", "1234567890123456789", "1,5"]
    for text in bad {
        match parse(text) {
            Ok(d) => assert(false, "expected an error for '${text}', got ${to_string(d)}"),
            Err(e) => assert(strings_len(e) > 0, "message"),
        }
    }
}

fn strings_len(s: string) -> int {
    s.len()
}

@test
fn test_parse_accepts_bare_fraction_and_whitespace() {
    assert_eq(show(parse(" .5 ")), "0.5")
    assert_eq(show(parse("5.")), "5")
}

@test
fn test_equality_ignores_scale() {
    assert(equals(new(150, 2), new(15, 1)), "1.50 == 1.5")
    assert_eq(compare(new(1, 0), new(99, 2)), 1)
    assert_eq(compare(new(-1, 0), new(-99, 2)), -1)
}

@test
fn test_overflow_is_an_error_not_a_wrap() {
    let big = new(9000000000000000000, 0)
    assert(show(add(big, big)).starts_with("error"), "add overflows")
    assert(show(mul(big, new(10, 0))).starts_with("error"), "mul overflows")
    assert(show(sub(neg(big), big)).starts_with("error"), "sub overflows")
    assert(show(rescale(big, 2, Rounding::Down)).starts_with("error"), "rescale up overflows")
}

@test
fn test_division_by_zero_and_bad_scale() {
    assert_eq(show(div(new(1, 0), new(0, 0), 2, Rounding::Down)), "error: division by zero")
    assert(show(div(new(1, 0), new(3, 0), 19, Rounding::Down)).starts_with("error"), "scale 19")
    assert(show(rescale(new(1, 0), -1, Rounding::Down)).starts_with("error"), "negative scale")
}

@test
fn test_money_split_never_loses_a_cent() {
    let parts = match allocate(new(10000, 2), [1, 1, 1]) {
        Ok(v) => v,
        Err(_) => [],
    }
    assert_eq(parts.len(), 3)
    assert_eq(to_string(parts[0]), "33.34")
    assert_eq(to_string(parts[1]), "33.33")
    assert_eq(to_string(parts[2]), "33.33")
    let uneven = match allocate(new(5, 2), [3, 7]) {
        Ok(v) => v,
        Err(_) => [],
    }
    assert_eq(to_string(uneven[0]), "0.02")
    assert_eq(to_string(uneven[1]), "0.03")
    let negative = match allocate(new(-10000, 2), [1, 1, 1]) {
        Ok(v) => v,
        Err(_) => [],
    }
    assert_eq(to_string(negative[0]), "-33.34")
    let skip_zero = match allocate(new(100, 2), [0, 1, 1]) {
        Ok(v) => v,
        Err(_) => [],
    }
    assert_eq(to_string(skip_zero[0]), "0.00")
    assert_eq(to_string(skip_zero[1]), "0.50")
    assert(allocate(new(100, 2), []).is_err(), "no ratios")
    assert(allocate(new(100, 2), [0, 0]).is_err(), "zero sum")
    assert(allocate(new(100, 2), [1, -1]).is_err(), "negative ratio")
}

@test
fn test_formatting() {
    assert_eq(with_thousands(new(123456789, 2)), "1,234,567.89")
    assert_eq(with_thousands(new(-100000, 2)), "-1,000.00")
    assert_eq(with_thousands(new(999, 0)), "999")
    assert_eq(with_thousands(new(1000, 0)), "1,000")
    assert_eq(placed(new(2675, 3), 2, Rounding::HalfEven), "2.68")
    assert_eq(placed(new(5, 0), 2, Rounding::Down), "5.00")
}

@test
fn test_sign_helpers() {
    assert_eq(signum(new(-3, 1)), -1)
    assert_eq(signum(new(0, 3)), 0)
    assert_eq(to_string(abs(new(-3, 1))), "0.3")
    assert_eq(to_string(neg(new(3, 1))), "-0.3")
    assert_eq(to_string(from_int(7)), "7")
}

@test
fn test_tax_and_total_example() {
    // 19.99 at 8.25% tax, rounded half-even to cents, added back to the price.
    let price = new(1999, 2)
    let rate = new(825, 4)
    let tax = match mul(price, rate) {
        Ok(t) => match rescale(t, 2, Rounding::HalfEven) {
            Ok(r) => r,
            Err(_) => new(0, 2),
        },
        Err(_) => new(0, 2),
    }
    assert_eq(to_string(tax), "1.65")
    assert_eq(show(add(price, tax)), "21.64")
}
