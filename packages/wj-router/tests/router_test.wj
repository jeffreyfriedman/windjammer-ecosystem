use crate::match_route
use std::collections::HashMap

@test
fn test_exact_path() {
    match match_route("/health", "/health") {
        Some(params) => assert_eq(params.len(), 0),
        None => assert(false, "exact path should match"),
    }
}

@test
fn test_exact_mismatch() {
    match match_route("/health", "/ready") {
        Some(_) => assert(false, "should not match"),
        None => assert(true, "mismatch"),
    }
}

@test
fn test_param_capture() {
    match match_route("/users/:id", "/users/42") {
        Some(params) => {
            match params.get("id") {
                Some(id) => assert_eq(id, "42"),
                None => assert(false, "missing id"),
            }
        },
        None => assert(false, "param route should match"),
    }
}

@test
fn test_multi_param() {
    match match_route("/orgs/:org/repos/:repo", "/orgs/acme/repos/api") {
        Some(params) => {
            match params.get("org") {
                Some(org) => assert_eq(org, "acme"),
                None => assert(false, "missing org"),
            }
            match params.get("repo") {
                Some(repo) => assert_eq(repo, "api"),
                None => assert(false, "missing repo"),
            }
        },
        None => assert(false, "multi-param should match"),
    }
}

@test
fn test_trailing_slash_normalized() {
    match match_route("/users/:id", "/users/7/") {
        Some(params) => {
            match params.get("id") {
                Some(id) => assert_eq(id, "7"),
                None => assert(false, "missing id"),
            }
        },
        None => assert(false, "trailing slash should still match"),
    }
}

@test
fn test_segment_count_mismatch() {
    match match_route("/users/:id", "/users/42/extra") {
        Some(_) => assert(false, "extra segment should fail"),
        None => assert(true, "mismatch"),
    }
}

@test
fn test_root() {
    match match_route("/", "/") {
        Some(params) => assert_eq(params.len(), 0),
        None => assert(false, "root should match"),
    }
}
