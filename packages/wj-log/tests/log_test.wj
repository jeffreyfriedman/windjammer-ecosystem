use crate::parse_level
use crate::level_label
use crate::level_rank
use crate::is_enabled
use crate::init_from_level_text
use crate::log_tagged
use std::log::LogLevel

fn test_parse_level_accepts_info() {
    assert(parse_level("info").is_some(), "info parses")
    assert(parse_level("INFO").is_some(), "INFO parses")
}

fn test_parse_level_rejects_unknown() {
    assert(parse_level("verbose").is_none(), "unknown level")
}

fn test_init_from_level_text_rejects_unknown() {
    match init_from_level_text("not-a-level") {
        Ok(_) => assert(false, "unknown level should fail"),
        Err(msg) => assert(msg.len() > 0, "error message"),
    }
}

fn test_init_from_level_text_accepts_debug() {
    match init_from_level_text("debug") {
        Ok(_) => {},
        Err(_) => assert(false, "init_from_level_text should accept debug"),
    }
}

fn test_log_tagged_info_runs() {
    log_tagged("info", "api", "started")
}

fn test_level_label_canonical() {
    assert_eq(level_label(LogLevel::Trace), "trace")
    assert_eq(level_label(LogLevel::Debug), "debug")
    assert_eq(level_label(LogLevel::Info), "info")
    assert_eq(level_label(LogLevel::Warn), "warn")
    assert_eq(level_label(LogLevel::Error), "error")
}

fn test_parse_level_roundtrip_labels() {
    match parse_level(level_label(LogLevel::Warn)) {
        Some(level) => assert_eq(level_label(level), "warn"),
        None => assert(false, "warn roundtrip"),
    }
}

fn test_level_rank_ordering() {
    assert(level_rank(LogLevel::Trace) < level_rank(LogLevel::Debug), "trace < debug")
    assert(level_rank(LogLevel::Debug) < level_rank(LogLevel::Info), "debug < info")
    assert(level_rank(LogLevel::Info) < level_rank(LogLevel::Warn), "info < warn")
    assert(level_rank(LogLevel::Warn) < level_rank(LogLevel::Error), "warn < error")
}

fn test_is_enabled_respects_minimum() {
    assert(is_enabled(LogLevel::Error, LogLevel::Warn), "error >= warn")
    assert(is_enabled(LogLevel::Warn, LogLevel::Warn), "warn >= warn")
    assert(!is_enabled(LogLevel::Info, LogLevel::Warn), "info < warn")
    assert(is_enabled(LogLevel::Trace, LogLevel::Trace), "trace >= trace")
}
