use std::crypto
use std::strings

/// Hash a password with bcrypt (default cost).
pub fn hash_password(password: string) -> Result<string, string> {
    crypto.hash_password(password)
}

/// Verify a password against a bcrypt hash from `hash_password`.
pub fn verify_password(password: string, hash: string) -> Result<bool, string> {
    crypto.verify_password(password, hash)
}

/// True when `hash` looks like a bcrypt digest (`$2a$` / `$2b$` / `$2y$` …).
pub fn looks_like_bcrypt(hash: string) -> bool {
    if strings.len(hash) < 4 {
        return false
    }
    strings.starts_with(hash, "$2")
}

/// Verify a password; returns `false` on mismatch or verify errors.
pub fn verify_ok(password: string, hash: string) -> bool {
    match verify_password(password, hash) {
        Ok(ok) => ok,
        Err(_) => false,
    }
}

/// Accept `hash` only when it looks like bcrypt; else return an error.
pub fn require_bcrypt(hash: string) -> Result<string, string> {
    if looks_like_bcrypt(hash) {
        return Ok(hash)
    }
    Err("expected bcrypt hash")
}

/// Alias of `looks_like_bcrypt` for call sites that prefer a prefix-shaped name.
pub fn is_bcrypt_prefix(hash: string) -> bool {
    looks_like_bcrypt(hash)
}
