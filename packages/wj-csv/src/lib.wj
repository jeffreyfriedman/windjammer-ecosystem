use std::csv

/// Parse CSV text into rows (RFC-style quoting via runtime `std::csv`).
pub fn parse(text: string) -> Result<Vec<Vec<string>>, string> {
    csv.parse(text)
}

/// First row is headers; remaining rows are data.
pub fn parse_with_headers(text: string) -> Result<(Vec<string>, Vec<Vec<string>>), string> {
    match csv.parse(text) {
        Ok(rows) => {
            if rows.len() == 0 {
                return Err("empty csv")
            }
            let headers = rows[0]
            let mut data = Vec::new()
            let mut i = 1
            while i < rows.len() {
                data.push(rows[i])
                i = i + 1
            }
            Ok((headers, data))
        },
        Err(e) => Err(e),
    }
}

/// Serialize rows to CSV text via runtime `std::csv`.
pub fn write(rows: Vec<Vec<string>>) -> Result<string, string> {
    csv.write(rows)
}
