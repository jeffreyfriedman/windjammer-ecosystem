@test
fn test_zip_writer_matches_python_stored_bytes() {
    let mut entries: Vec<Entry> = Vec::new()
    entries.push(stamped(dir("docs"), 1709647629, 493))
    entries.push(stamped(file("docs/readme.txt", utf8("hello\n")), 1709647629, 420))
    entries.push(stamped(file("empty.txt", Vec::new()), 0, 420))
    entries.push(stamped(file("data.bin", pattern(600)), 1709647629, 493))
    entries.push(stamped(file("naïve/ünï.txt", utf8("café")), 1709647629, 420))
    let got = must(zip::write(entries))
    let want = rle(["504b0304140000000000e470655800000000000000000000000005000000646f63732f504b0304140000000000e470655820303a3606000000060000000f000000646f63732f726561646d652e74787468656c6c6f0a504b030414000000000000002100", "00000000000000000000000009000000656d7074792e747874504b0304140000000000e47065582eec550c580200005802000008000000646174612e62696e030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dce3eaf1f804", "0b121920272e353c434a51585f666d747b828990979ea5acb3bac1c8cfd6dde4ebf2f9050c131a21282f363d444b525960676e757c838a91989fa6adb4bbc2c9d0d7dee5ecf3fa060d141b222930373e454c535a61686f767d848b9299a0a7aeb5bcc3ca", "d1d8dfe6edf400070e151c232a31383f464d545b626970777e858c939aa1a8afb6bdc4cbd2d9e0e7eef501080f161d242b323940474e555c636a71787f868d949ba2a9b0b7bec5ccd3dae1e8eff6020910171e252c333a41484f565d646b727980878e95", "9ca3aab1b8bfc6cdd4dbe2e9f0f7030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dce3eaf1f8040b121920272e353c434a51585f666d747b828990979ea5acb3bac1c8cfd6dde4ebf2f9050c131a21282f363d444b525960", "676e757c838a91989fa6adb4bbc2c9d0d7dee5ecf3fa060d141b222930373e454c535a61686f767d848b9299a0a7aeb5bcc3cad1d8dfe6edf400070e151c232a31383f464d545b626970777e858c939aa1a8afb6bdc4cbd2d9e0e7eef501080f161d242b", "323940474e555c636a71787f868d949ba2a9b0b7bec5ccd3dae1e8eff6020910171e252c333a41484f565d646b727980878e959ca3aab1b8bfc6cdd4dbe2e9f0f7030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dce3eaf1", "f8040b121920272e353c434a51585f666d747b828990979ea5acb3bac1c8cfd6dde4ebf2f9050c131a21282f363d444b525960676e757c838a91989fa6adb4504b0304140000080000e4706558b542ad980500000005000000100000006e61c3af76652f", "c3bc6ec3af2e747874636166c3a9504b01021403140000000000e4706558000000000000000000000000050000000000000000001000ed4100000000646f63732f504b01021403140000000000e470655820303a3606000000060000000f000000000000", "0000000000a48123000000646f63732f726561646d652e747874504b0102140314000000000000002100000000000000000000000000090000000000000000000000a48156000000656d7074792e747874504b01021403140000000000e47065582eec55", "0c5802000058020000080000000000000000000000ed817d000000646174612e62696e504b01021403140000080000e4706558b542ad980500000005000000100000000000000000000000a481fb0200006e61c3af76652fc3bc6ec3af2e747874504b05", "0600000000050005001b0100002e0300000000"])
    assert_eq(got.len(), want.len())
    assert_eq(hex(got), hex(want))
}

