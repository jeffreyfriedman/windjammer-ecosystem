    assert_eq(text_of(rescale(dec("-1.15"), 1, mode_named("Floor"))), "-1.2")
    assert_eq(text_of(rescale(dec("-1.15"), 1, mode_named("Ceiling"))), "-1.1")
    assert_eq(text_of(rescale(dec("-1.15"), 1, mode_named("HalfUp"))), "-1.2")
    assert_eq(text_of(rescale(dec("-1.15"), 1, mode_named("HalfDown"))), "-1.1")
    assert_eq(text_of(rescale(dec("-1.15"), 1, mode_named("HalfEven"))), "-1.2")
    assert_eq(text_of(rescale(dec("-1.15"), 2, mode_named("Down"))), "-1.15")
    assert_eq(text_of(rescale(dec("-1.15"), 2, mode_named("Up"))), "-1.15")
    assert_eq(text_of(rescale(dec("-1.15"), 2, mode_named("Floor"))), "-1.15")
    assert_eq(text_of(rescale(dec("-1.15"), 2, mode_named("Ceiling"))), "-1.15")
    assert_eq(text_of(rescale(dec("-1.15"), 2, mode_named("HalfUp"))), "-1.15")
    assert_eq(text_of(rescale(dec("-1.15"), 2, mode_named("HalfDown"))), "-1.15")
    assert_eq(text_of(rescale(dec("-1.15"), 2, mode_named("HalfEven"))), "-1.15")
    assert_eq(text_of(rescale(dec("0.125"), 0, mode_named("Down"))), "0")
    assert_eq(text_of(rescale(dec("0.125"), 0, mode_named("Up"))), "1")
    assert_eq(text_of(rescale(dec("0.125"), 0, mode_named("Floor"))), "0")
    assert_eq(text_of(rescale(dec("0.125"), 0, mode_named("Ceiling"))), "1")
    assert_eq(text_of(rescale(dec("0.125"), 0, mode_named("HalfUp"))), "0")
    assert_eq(text_of(rescale(dec("0.125"), 0, mode_named("HalfDown"))), "0")
    assert_eq(text_of(rescale(dec("0.125"), 0, mode_named("HalfEven"))), "0")
    assert_eq(text_of(rescale(dec("0.125"), 1, mode_named("Down"))), "0.1")
    assert_eq(text_of(rescale(dec("0.125"), 1, mode_named("Up"))), "0.2")
    assert_eq(text_of(rescale(dec("0.125"), 1, mode_named("Floor"))), "0.1")
