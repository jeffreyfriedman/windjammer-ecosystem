use std::strings

fn is_blank(line: string) -> bool {
    strings.len(strings.trim(line)) == 0
}

fn indent_of(line: string) -> int {
    let mut n = 0
    for ch in strings.chars(line) {
        if ch == ' ' {
            n = n + 1
        } else {
            break
        }
    }
    n
}

fn starts_item(line: string) -> bool {
    strings.starts_with(strings.trim(line), "-")
}

/// A line passed to a helper in a condition and used again later: the earlier call moves it (E0382).
pub fn gaps(items: Vec<string>) -> int {
    let mut count = 0
    for l in items {
        if is_blank(l) {
            count = count + 1
        } else {
            if indent_of(l) == 0 {
                count = count + 10
            }
        }
    }
    count
}

/// The same inside one `&&` chain.
pub fn continues(last: string, line: string) -> bool {
    !is_blank(last) && !starts_item(line) && indent_of(line) == 0
}

/// A line read from a Vec by index, tested in an `&&` chain and then pushed: the middle test moves it (E0382).
pub fn collect(lines: Vec<string>) -> Vec<string> {
    let mut content: Vec<string> = Vec::new()
    let mut i = 0
    while i < lines.len() {
        let line = lines[i]
        let last = if content.len() == 0 { "x" } else { content[content.len() - 1] }
        if !is_blank(last) && !starts_item(line) && indent_of(line) == 0 {
            content.push(line)
        }
        i = i + 1
    }
    content
}
