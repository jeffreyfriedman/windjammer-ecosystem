// Golden set gate: every program in golden/ is a small idiomatic Windjammer program that runs the same interpreted and
// compiled, prints exactly its .expected file, and carries no workaround. Run from the repository root.
//
//   wj run --interpret --allow process --allow fs.read --allow fs.write --allow env.read --allow console \
//       scripts/golden_gate.wj <command> [wj-binary] [program names...]
//
//   --check                 static rules + fresh golden/INDEX.md and llms-golden.txt (no program is run)
//   --write                 regenerate golden/INDEX.md and llms-golden.txt
//   --interp <wj>           run every program interpreted and compare with its .expected file
//   --compiled <wj>         run every program compiled (`wj run --compiled`) and compare; set SLOT_CMD to a build-slot wrapper
//   --both <wj>             both of the above
//   --record <wj> <names>   write <name>.expected from the interpreted output (review the diff before committing)
//   --self-test             prove each static rule and the output comparison fire on planted input
//
// Static rules per program: file name `<category>_<topic>.wj`; first line `// golden: <title>`; second line
// `// idiom: <what it teaches>`; 30 to 120 lines; no `wj-gap`; an .expected file; and no line the idiom audit would flag
// (`scripts/idiom_audit.wj --golden`). INDEX.md and llms-golden.txt are generated, and llms-golden.txt must stay within
// TOKEN_BUDGET estimated tokens (bytes / 3, a deliberately high estimate for code).
use std::process
use std::fs
use std::env
use std::strings

const MIN_LINES: int = 30
const MAX_LINES: int = 120
const TOKEN_BUDGET: int = 60000

fn sh_quote(s: string) -> string {
    "'${strings.replace(s, "'", "'\\''")}'"
}

fn names() -> Vec<string> {
    let mut out: Vec<string> = []
    match fs.read_dir("golden") {
        Ok(entries) => {
            for e in entries {
                let n = e.name()
                if strings.ends_with(n, ".wj") {
                    out.push(strings.replace(n, ".wj", ""))
                }
            }
        },
        Err(e) => {
            println("cannot read golden/: ${e}")
            process.exit(1)
        },
    }
    out.sort()
    out
}

fn read(path: string) -> string {
    fs.read_to_string(path).unwrap_or("")
}

fn category(name: string) -> string {
    strings.split(name, "_")[0]
}

// Static problems with one program's source, as messages (empty when the program is well formed).
fn source_problems(name: string, src: string, has_expected: bool) -> Vec<string> {
    let mut bad: Vec<string> = []
    let lines = strings.split_lines(src)
    if !strings.contains(name, "_") {
        bad.push("${name}: file name must be <category>_<topic>.wj")
    }
    if lines.len() < MIN_LINES || lines.len() > MAX_LINES {
        bad.push("${name}: ${lines.len()} lines, expected ${MIN_LINES} to ${MAX_LINES}")
    }
    if lines.len() < 2 || !strings.starts_with(lines[0], "// golden: ") {
        bad.push("${name}: first line must be `// golden: <title>`")
    }
    if lines.len() < 2 || !strings.starts_with(lines[1], "// idiom: ") {
        bad.push("${name}: second line must be `// idiom: <what it teaches>`")
    }
    if strings.contains(src, "wj-gap") {
        bad.push("${name}: golden programs carry no wj-gap marker")
    }
    if !has_expected {
        bad.push("${name}: missing ${name}.expected")
    }
    bad
}

fn title_of(src: string) -> string {
    strings.replace(strings.split_lines(src)[0], "// golden: ", "")
}

fn idiom_of(src: string) -> string {
    strings.replace(strings.split_lines(src)[1], "// idiom: ", "")
}

fn est_tokens(text: string) -> int {
    (text.len() as int + 2) / 3
}

fn index_text(all: Vec<string>) -> string {
    let mut out = "# Golden programs\n\n"
    out += "Generated by `scripts/golden_gate.wj --write`; do not edit by hand. Each program is a complete, idiomatic Windjammer program that runs the same interpreted and compiled and prints exactly its `.expected` file. "
    out += "`llms-golden.txt` concatenates them for use as in-context examples.\n\n"
    out += "${all.len()} programs.\n\n"
    out += "| Program | Category | What it teaches | Lines |\n|---|---|---|---:|\n"
    for n in all {
        let src = read("golden/${n}.wj")
        out += "| [${n}.wj](${n}.wj) | ${category(n)} | ${idiom_of(src)} | ${strings.split_lines(src).len()} |\n"
    }
    out
}

fn llms_text(all: Vec<string>) -> string {
    let mut out = "# Windjammer golden programs\n"
    out += "# ${all.len()} complete idiomatic programs. Each runs the same interpreted (wj run --interpret) and compiled (wj run --compiled).\n"
    out += "# Each program is followed by the exact output it prints.\n\n"
    for n in all {
        let src = read("golden/${n}.wj")
        out += "=== ${n}.wj ===\n${src}"
        if !strings.ends_with(src, "\n") {
            out += "\n"
        }
        out += "--- output ---\n${read("golden/${n}.expected")}"
        if !strings.ends_with(read("golden/${n}.expected"), "\n") {
            out += "\n"
        }
        out += "\n"
    }
    out
}

fn static_check(all: Vec<string>) -> int {
    let mut failures = 0
    if all.len() < 60 {
        println("golden set has ${all.len()} programs, the target is at least 60")
        failures += 1
    }
    for n in all {
        let src = read("golden/${n}.wj")
        for p in source_problems(n, src, fs.exists("golden/${n}.expected")) {
            println(p)
            failures += 1
        }
    }
    let llms = llms_text(all)
    if est_tokens(llms) > TOKEN_BUDGET {
        println("llms-golden.txt is about ${est_tokens(llms)} tokens, over the budget of ${TOKEN_BUDGET}")
        failures += 1
    }
    if read("golden/INDEX.md") != index_text(all) {
        println("golden/INDEX.md is stale; run scripts/golden_gate.wj --write")
        failures += 1
    }
    if read("llms-golden.txt") != llms {
        println("llms-golden.txt is stale; run scripts/golden_gate.wj --write")
        failures += 1
    }
    failures
}

// The program's stdout when it exits 0, else a message starting with `FAILED`.
fn run_program(wj: string, mode: string, name: string) -> string {
    let slot = env::var("SLOT_CMD").unwrap_or("")
    let flag = if mode == "interp" { "--interpret --allow fs.read --allow fs.write --allow env.read --allow process --allow console" } else { "--compiled" }
    let wrap = if mode == "compiled" && slot.len() > 0 { "${slot} " } else { "" }
    let line = "${wrap}${sh_quote(wj)} run ${flag} ${sh_quote("golden/${name}.wj")}"
    match process.run_with_output("sh", ["-c", line]) {
        Ok(o) => {
            if o.status != 0 {
                return "FAILED (exit ${o.status}): ${first_line(o.stderr)}"
            }
            o.stdout
        },
        Err(e) => "FAILED: ${e}",
    }
}

fn first_line(text: string) -> string {
    let lines = strings.split_lines(strings.trim(text))
    if lines.len() == 0 { "" } else { lines[lines.len() - 1] }
}

fn run_all(wj: string, mode: string, selected: Vec<string>) -> int {
    let mut failures = 0
    for n in selected {
        let want = read("golden/${n}.expected")
        let got = run_program(wj, mode, n)
        if got != want {
            println("DRIFT ${mode} ${n}: ${if strings.starts_with(got, "FAILED") { got } else { "output differs from ${n}.expected" }}")
            failures += 1
        } else {
            println("ok ${mode} ${n}")
        }
    }
    failures
}

fn self_test() -> int {
    let mut failures = 0
    let good = "// golden: t\n// idiom: i\n${strings.repeat("let a = 1\n", 30)}"
    if source_problems("text_ok", good, true).len() != 0 {
        println("self-test FAIL: a well formed program was rejected")
        failures += 1
    }
    let planted: Vec<(string, string, bool)> = [
        ("noprefix", good, true),
        ("text_short", "// golden: t\n// idiom: i\nlet a = 1\n", true),
        ("text_notitle", "// title\n// idiom: i\n${strings.repeat("let a = 1\n", 30)}", true),
        ("text_noidiom", "// golden: t\n// what\n${strings.repeat("let a = 1\n", 30)}", true),
        ("text_gap", "// golden: t\n// idiom: i\n// wj-gap: x\n${strings.repeat("let a = 1\n", 30)}", true),
        ("text_noexpected", good, false),
    ]
    for p in planted {
        if source_problems(p.0, p.1, p.2).len() == 0 {
            println("self-test FAIL: ${p.0} passed the static rules")
            failures += 1
        }
    }
    if est_tokens(strings.repeat("x", 300)) != 100 {
        println("self-test FAIL: token estimate")
        failures += 1
    }
    failures
}

fn main() {
    let args = env::args()
    let cmd = if args.len() > 1 { args[1] } else { "--check" }
    if cmd == "--self-test" {
        let failures = self_test()
        if failures > 0 {
            process.exit(1)
        }
        println("self-test ok: every static rule fires on a planted program")
        return
    }
    let all = names()
    if cmd == "--write" {
        fs.write("golden/INDEX.md", index_text(all))
        fs.write("llms-golden.txt", llms_text(all))
        let llms = llms_text(all)
        println("wrote golden/INDEX.md and llms-golden.txt: ${all.len()} programs, ${llms.len()} bytes, about ${est_tokens(llms)} tokens")
        return
    }
    if cmd == "--check" {
        let failures = static_check(all)
        if failures > 0 {
            process.exit(1)
        }
        println("golden static checks ok: ${all.len()} programs, llms-golden.txt about ${est_tokens(llms_text(all))} tokens")
        return
    }
    if args.len() < 3 {
        println("usage: golden_gate.wj ${cmd} <wj-binary> [names...]")
        process.exit(2)
    }
    let wj = args[2]
    let mut selected: Vec<string> = []
    let mut i = 3
    while i < args.len() {
        selected.push(args[i])
        i += 1
    }
    if selected.len() == 0 {
        selected = all
    }
    if cmd == "--record" {
        for n in selected {
            let got = run_program(wj, "interp", n)
            if strings.starts_with(got, "FAILED") {
                println("${n}: ${got}")
                process.exit(1)
            }
            fs.write("golden/${n}.expected", got)
            println("recorded ${n}")
        }
        return
    }
    let mut failures = 0
    if cmd == "--interp" || cmd == "--both" {
        failures += run_all(wj, "interp", selected)
    }
    if cmd == "--compiled" || cmd == "--both" {
        failures += run_all(wj, "compiled", selected)
    }
    if failures > 0 {
        println("golden gate: ${failures} failure(s)")
        process.exit(1)
    }
    println("golden gate ok")
}
