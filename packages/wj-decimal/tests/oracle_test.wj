    assert_eq(text_of(rescale(dec("0.001"), 2, mode_named("HalfUp"))), "0.00")
    assert_eq(text_of(rescale(dec("0.001"), 2, mode_named("HalfDown"))), "0.00")
    assert_eq(text_of(rescale(dec("0.001"), 2, mode_named("HalfEven"))), "0.00")
    assert_eq(text_of(rescale(dec("-0.0049"), 0, mode_named("Down"))), "0")
    assert_eq(text_of(rescale(dec("-0.0049"), 0, mode_named("Up"))), "-1")
    assert_eq(text_of(rescale(dec("-0.0049"), 0, mode_named("Floor"))), "-1")
    assert_eq(text_of(rescale(dec("-0.0049"), 0, mode_named("Ceiling"))), "0")
