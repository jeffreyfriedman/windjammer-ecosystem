# Generated by Cargo / Windjammer
debug/
**/target/
**/build/
build_output/

# Windjammer compiler caches & stamps
.wj-cache/
.wj-compiler-stamp

# Generated Rust / Cargo artifacts inside WJ projects
**/*.rs.map
**/*.rlib
**/*.rmeta
*.pdb
**/*.rs.bk

# Per-app generated Rust (templates ignore *.rs + Cargo.toml at project root)
# Keep hand-written Rust forbidden; generated output is local-only.
apps/**/Cargo.toml
apps/**/Cargo.lock
packages/**/Cargo.toml
packages/**/Cargo.lock
apps/**/src/**/*.rs
packages/**/src/**/*.rs

# Integration / test scratch
/test_output_*
coverage/
*.log

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local issue tracking / agent scratch
.beads/
.pr-comments/
.sandbox/
.agent-wip/
tmp_*
**/*.wip.rs

# Mutation testing
**/mutants.out*/
