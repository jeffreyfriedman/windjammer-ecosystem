use std::compress
use std::strings

/// True when `Accept-Encoding` allows gzip (`gzip`, `*`, ignoring `q=0`).
pub fn accepts_gzip(accept_encoding: string) -> bool {
    let header = strings.trim(accept_encoding)
    if strings.len(header) == 0 {
        return false
    }
    let parts = strings.split(header, ",")
    let mut i = 0
    while i < parts.len() {
        let token = strings.trim(parts[i])
        if coding_allows_gzip(token) {
            return true
        }
        i = i + 1
    }
    false
}

/// Prefer gzip when listed; otherwise `None` (caller may send identity).
pub fn negotiate(accept_encoding: string) -> Option<string> {
    if accepts_gzip(accept_encoding) {
        return Some("gzip")
    }
    None
}

/// `Content-Encoding` value for gzip responses.
pub fn content_encoding_gzip() -> string {
    "gzip"
}

/// Gzip-encode UTF-8 text; returns Base64 of compressed bytes (`std::compress`).
pub fn gzip_encode(body: string) -> Result<string, string> {
    compress.gzip_encode(body)
}

/// Gzip-decode a Base64 gzip payload back to UTF-8 text.
pub fn gzip_decode(encoded: string) -> Result<string, string> {
    compress.gzip_decode(encoded)
}

/// True when the client asked for identity / sent an empty Accept-Encoding.
pub fn prefer_identity(accept_encoding: string) -> bool {
    let header = strings.trim(accept_encoding)
    if strings.len(header) == 0 {
        return true
    }
    let lower = strings.to_lower(header)
    lower == "identity"
}

fn coding_allows_gzip(token: string) -> bool {
    if strings.len(token) == 0 {
        return false
    }
    let name = coding_name(token)
    let q = coding_q(token)
    if q_is_zero(q) {
        return false
    }
    let lower = strings.to_lower(name)
    lower == "gzip" || lower == "*"
}

fn coding_name(token: string) -> string {
    let semi = find_char(token, ";")
    if semi < 0 {
        return strings.trim(token)
    }
    strings.trim(strings.substring(token, 0, semi))
}

fn coding_q(token: string) -> string {
    let lower = strings.to_lower(token)
    let parts = strings.split(lower, "q=")
    if parts.len() < 2 {
        return "1"
    }
    let rest = parts[1]
    let mut out = ""
    let chars = strings.chars(rest)
    for ch in chars {
        if ch == ',' || ch == ';' || ch == ' ' {
            break
        }
        out = "${out}${ch}"
    }
    strings.trim(out)
}

fn q_is_zero(q: string) -> bool {
    if q == "0" {
        return true
    }
    if q == "0.0" {
        return true
    }
    if q == "0.00" {
        return true
    }
    if q == "0.000" {
        return true
    }
    false
}

fn find_char(text: string, needle: string) -> int {
    let mut i = 0
    let n = strings.len(text)
    while i < n {
        if strings.substring(text, i, i + 1) == needle {
            return i
        }
        i = i + 1
    }
    -1
}
