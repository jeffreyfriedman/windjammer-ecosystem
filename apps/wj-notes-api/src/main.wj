use crate::domain::NoteStore
use crate::domain::config_from_env
use crate::domain::port_from_env
use crate::adapters::serve

fn main() {
    let port = port_from_env()
    let config = config_from_env()
    let store = NoteStore::new()
    println("wj-notes-api listening on http://0.0.0.0:${port}")
    match serve(port, store, config) {
        Ok(_) => {},
        Err(err) => println("wj-notes-api error: ${err}"),
    }
}
