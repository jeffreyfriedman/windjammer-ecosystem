// Domain: version identity for the wj-hello smoke binary.

/// Package / binary crate name.
pub fn crate_name() -> string {
    "wj-hello"
}

/// Semver for this smoke app.
pub fn semver() -> string {
    "0.1.0"
}

/// Combined identity line (`crate_name` + space + `semver`).
pub fn version() -> string {
    "${crate_name()} ${semver()}"
}
