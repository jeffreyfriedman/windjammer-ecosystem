use crate::domain::NoteStore
use crate::domain::NotesConfig
use crate::domain::NotesApp
use crate::domain::handle_request

fn default_config() -> NotesConfig {
    NotesConfig {
        allowed_origins: allowed_one(),
        rate_limit: 100,
        window_ms: 60_000,
    }
}

fn allowed_one() -> Vec<string> {
    let mut out = Vec::new()
    out.push("https://app.example.com")
    out
}

fn test_get_notes_empty_returns_json_array() {
    let store = NoteStore::new()
    let reply = handle_request("GET", "/notes", "", store)
    assert_eq(reply.status, 200)
    assert_str_contains(reply.body, "[")
}

fn test_post_creates_note_with_201() {
    let mut store = NoteStore::new()
    let body = "{\"title\":\"hello\",\"body\":\"world\"}"
    let reply = handle_request("POST", "/notes", body, store)
    assert_eq(reply.status, 201)
    assert_str_contains(reply.body, "hello")
    assert_str_contains(reply.body, "world")
}

fn test_get_note_by_id() {
    let mut store = NoteStore::new()
    let _ = store.create("item", "detail")
    let reply = handle_request("GET", "/notes/1", "", store)
    assert_eq(reply.status, 200)
    assert_str_contains(reply.body, "item")
    assert_str_contains(reply.body, "detail")
}

fn test_get_missing_note_returns_404() {
    let store = NoteStore::new()
    let reply = handle_request("GET", "/notes/99", "", store)
    assert_eq(reply.status, 404)
}

fn test_put_updates_note() {
    let mut store = NoteStore::new()
    let _ = store.create("old", "x")
    let body = "{\"title\":\"new\",\"body\":\"y\"}"
    let reply = handle_request("PUT", "/notes/1", body, store)
    assert_eq(reply.status, 200)
    assert_str_contains(reply.body, "new")
    assert_str_contains(reply.body, "y")
}

fn test_delete_note_returns_204() {
    let mut store = NoteStore::new()
    let _ = store.create("gone", "z")
    let reply = handle_request("DELETE", "/notes/1", "", store)
    assert_eq(reply.status, 204)
    assert_eq(reply.body.len(), 0)
}

fn test_post_invalid_json_returns_400() {
    let store = NoteStore::new()
    let reply = handle_request("POST", "/notes", "{bad", store)
    assert_eq(reply.status, 400)
}

fn test_unknown_path_returns_404() {
    let store = NoteStore::new()
    let reply = handle_request("GET", "/missing", "", store)
    assert_eq(reply.status, 404)
}

fn test_health_returns_ok() {
    let store = NoteStore::new()
    let reply = handle_request("GET", "/health", "", store)
    assert_eq(reply.status, 200)
    assert_str_contains(reply.body, "ok")
}

fn test_router_matches_note_id() {
    let mut store = NoteStore::new()
    let _ = store.create("via-router", "body")
    let reply = handle_request("GET", "/notes/1", "", store)
    assert_eq(reply.status, 200)
    assert_str_contains(reply.body, "via-router")
}

fn test_cors_origin_on_json_response() {
    let mut app = NotesApp::new(default_config(), NoteStore::new())
    let reply = app.handle("GET", "/notes", "https://app.example.com", "client", 0, "")
    assert_eq(reply.allow_origin, "https://app.example.com")
}

fn test_options_preflight_sets_cors_origin() {
    let mut app = NotesApp::new(default_config(), NoteStore::new())
    let reply = app.handle("OPTIONS", "/notes", "https://app.example.com", "", 0, "")
    assert_eq(reply.status, 204)
    assert_eq(reply.allow_origin, "https://app.example.com")
}

fn test_rate_limit_returns_429() {
    let mut config = default_config()
    config.rate_limit = 2
    let mut app = NotesApp::new(config, NoteStore::new())
    let _ = app.handle("GET", "/notes", "", "client-a", 1000, "")
    let _ = app.handle("GET", "/notes", "", "client-a", 1000, "")
    let third = app.handle("GET", "/notes", "", "client-a", 1000, "")
    assert_eq(third.status, 429)
    assert_str_contains(third.extra_headers, "Retry-After")
}

fn test_security_headers_on_response() {
    let mut app = NotesApp::new(default_config(), NoteStore::new())
    let reply = app.handle("GET", "/notes", "", "client", 0, "")
    assert_str_contains(reply.extra_headers, "X-Frame-Options")
    assert_str_contains(reply.extra_headers, "X-Content-Type-Options")
}
