// Expected HTML comes from markdown-it-py 3.0.0 (CommonMark preset, html disabled): the independent oracle.
use crate::inline_html

fn check_inline(source: string, expected: string) {
    let got = inline_html(source)
    assert_eq(got, expected)
}

@test
fn test_inline_matches_commonmark_oracle() {
    check_inline("plain text", "plain text")
    check_inline("*foo bar*", "<em>foo bar</em>")
    check_inline("**foo bar**", "<strong>foo bar</strong>")
    check_inline("_foo_ and __bar__", "<em>foo</em> and <strong>bar</strong>")
    check_inline("***strong emph***", "<em><strong>strong emph</strong></em>")
    check_inline("foo*bar*baz", "foo<em>bar</em>baz")
    check_inline("foo_bar_baz", "foo_bar_baz")
    check_inline("*foo**bar**baz*", "<em>foo<strong>bar</strong>baz</em>")
    check_inline("**foo *bar* baz**", "<strong>foo <em>bar</em> baz</strong>")
    check_inline("_ a _", "_ a _")
    check_inline("a * foo bar*", "a * foo bar*")
    check_inline("*(*foo*)*", "<em>(<em>foo</em>)</em>")
    check_inline("**foo*", "*<em>foo</em>")
    check_inline("*foo**", "<em>foo</em>*")
    check_inline("`code` here", "<code>code</code> here")
    check_inline("`` a`b ``", "<code>a`b</code>")
    check_inline("` a `", "<code>a</code>")
    check_inline("`foo", "`foo")
    check_inline("[link](/uri)", "<a href=\"/uri\">link</a>")
    check_inline("[link](/uri \"title\")", "<a href=\"/uri\" title=\"title\">link</a>")
    check_inline("[link](</my uri>)", "<a href=\"/my%20uri\">link</a>")
    check_inline("[a](b(c)d)", "<a href=\"b(c)d\">a</a>")
    check_inline("[a *b* c](/u)", "<a href=\"/u\">a <em>b</em> c</a>")
    check_inline("![img](/a.png)", "<img src=\"/a.png\" alt=\"img\" />")
    check_inline("![foo *bar*](/url \"t\")", "<img src=\"/url\" alt=\"foo bar\" title=\"t\" />")
    check_inline("[x](javascript:alert(1))", "[x](javascript:alert(1))")
    check_inline("<https://example.com/a?b=1&c=2>", "<a href=\"https://example.com/a?b=1&amp;c=2\">https://example.com/a?b=1&amp;c=2</a>")
    check_inline("<foo@bar.example.com>", "<a href=\"mailto:foo@bar.example.com\">foo@bar.example.com</a>")
    check_inline("<b>bold</b>", "&lt;b&gt;bold&lt;/b&gt;")
    check_inline("a < b & c > d \"q\"", "a &lt; b &amp; c &gt; d &quot;q&quot;")
    check_inline("\\*not emphasis\\*", "*not emphasis*")
    check_inline("\\# hash \\[x\\]", "# hash [x]")
    check_inline("foo\\\nbar", "foo<br />\nbar")
    check_inline("foo  \nbar", "foo<br />\nbar")
    check_inline("foo\nbar", "foo\nbar")
    check_inline("a\\b", "a\\b")
    check_inline("&amp; &lt; &quot; x", "&amp; &lt; &quot; x")
    check_inline("[unclosed](/u", "[unclosed](/u")
    check_inline("[ref][x]", "[ref][x]")
    check_inline("foo [bar](/u \"ti\\\"tle\") baz", "foo <a href=\"/u\" title=\"ti&quot;tle\">bar</a> baz")
    check_inline("http://auto.link/plain", "http://auto.link/plain")
    check_inline("[é](/ü ñ)", "[é](/ü ñ)")
    check_inline("[a](/b%20c%zz)", "<a href=\"/b%20c%25zz\">a</a>")
    check_inline("2 * 3 * 4", "2 * 3 * 4")
    check_inline("snake_case_word and _emph_", "snake_case_word and <em>emph</em>")
    check_inline("**bold**text", "<strong>bold</strong>text")
    check_inline("a**b**c", "a<strong>b</strong>c")
    check_inline("***a** b*", "<em><strong>a</strong> b</em>")
    check_inline("***a* b**", "<strong><em>a</em> b</strong>")
    check_inline("~~strike~~", "~~strike~~")
    check_inline("*a **b** c*", "<em>a <strong>b</strong> c</em>")
}
