use std::collections::HashMap

fn lookup(map: HashMap<string, string>, name: string) -> Option<string> {
    match map.get(name) {
        Some(v) => Some(v),
        None => None,
    }
}

fn main() {
    let mut m = HashMap::new()
    m.insert("a", "1")
    let r = lookup(m, "zz")
    println("${r.is_some()}")
}
